  matrixRows            StrategicPlanMatrixRow[]
  subsidiaryAlignments  SubsidiaryObjectiveAlignment[]

  @@unique([pillarId, objectiveCode])
  @@index([organizationId, pillarId])
  @@index([organizationId, leadOrgUnitId])
  @@index([organizationId, mandateId])
  @@index([organizationId, deletedAt])
  @@map("strategic_objectives")
}

// Joint Accountability Link for Horizontal Delivery Across OrgUnits
model ObjectiveContributingUnit {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @db.Uuid
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  strategicObjectiveId String             @db.Uuid
  strategicObjective   StrategicObjective @relation(fields: [strategicObjectiveId], references: [id], onDelete: Cascade)

  orgUnitId            String             @db.Uuid
  orgUnit              OrgUnit            @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  roleDescription      String             @db.Text // e.g. "Lead Infrastructure Partner" or "Data Provider"
  contributionWeight   Decimal            @default(0.00) @db.Decimal(5, 2)
  isLeadCoordinator    Boolean            @default(false)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([strategicObjectiveId, orgUnitId])
  @@index([organizationId, strategicObjectiveId])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, deletedAt])
  @@map("objective_contributing_units")
}

enum KpiDirectionOfGood {
  INCREASING_BETTER // Standard e.g. Revenue, Treated Water Volume, Tree Cover
  DECREASING_BETTER // Defect Rate, Maternal Mortality, Water Loss Non-Revenue %
  MAINTAIN_RANGE    // pH Level, System Pressure, Budget Variance Tolerance
}

enum KpiCalculationMethod {
  SUM_CUMULATIVE    // Sum over periods e.g. Total Boreholes Drilled
  AVERAGE_MEAN      // Mean average over quarters e.g. Customer Satisfaction %
  POINT_IN_TIME     // End-of-cycle snapshot e.g. Headcount, Forest Coverage
  WEIGHTED_INDEX    // Composite performance index
}

enum IndicatorLevel {
  NATIONAL_TIER_1     // Tracked by Presidency/Cabinet/National Planning Body
  CORPORATE_TIER_2    // Tracked by Board of Directors & Chief Executive Officer
  DIVISIONAL_TIER_3   // Tracked by Executive Directors / General Managers
  DEPARTMENTAL_TIER_4 // Tracked by Heads of Department / Unit Sectional Heads
}

model KeyPerformanceIndicator {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @db.Uuid
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  strategicObjectiveId  String               @db.Uuid
  strategicObjective    StrategicObjective   @relation(fields: [strategicObjectiveId], references: [id], onDelete: Cascade)

  kpiCode               String               @db.VarChar(32)
  kpiTitle              String               @db.VarChar(255)
  description           String?              @db.Text
  indicatorLevel        IndicatorLevel       @default(CORPORATE_TIER_2)
  unitOfMeasure         String               @db.VarChar(64) // e.g. "Cubic Meters/Day", "Percentage %", "Kilometers"
  directionOfGood       KpiDirectionOfGood   @default(INCREASING_BETTER)
  calculationMethod     KpiCalculationMethod @default(SUM_CUMULATIVE)

  // Explicit Baseline Anchor (Mandatory Single Source of Truth)
  baselineValue         Decimal              @db.Decimal(14, 4)
  baselineDate          DateTime             @db.Date
  baselineNotes         String?              @db.Text

  // Annual Target & Stretch Horizons
  annualTargetValue     Decimal              @db.Decimal(14, 4)
  stretchTargetValue    Decimal?             @db.Decimal(14, 4)
  weight                Decimal              @default(0.00) @db.Decimal(5, 2)
  actualValueAchieved   Decimal?             @db.Decimal(14, 4)

  dataCollectionSource  String               @db.VarChar(255) // e.g. "SCADA Telemetry System", "ERP Logistics"
  verificationMethod    String               @db.Text
  isStatutoryReportable Boolean              @default(true)
  isActive              Boolean              @default(true)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(6)

  periodicTargets       KpiPeriodicTarget[]
  unitTargets           UnitKpiTarget[]
  workplanActivities    WorkplanActivity[]
  performanceAgreementItems PerformanceAgreementItem[]
  storyBankEntries      StoryBankEntry[]
  matrixRows            StrategicPlanMatrixRow[]
  subsidiaryAlignments  SubsidiaryObjectiveAlignment[]

  @@unique([strategicObjectiveId, kpiCode])
  @@index([organizationId, strategicObjectiveId])
  @@index([organizationId, indicatorLevel])
  @@index([organizationId, deletedAt])
  @@map("key_performance_indicators")
}

// Periodic Breakdown of KPI Targets (Q1, Q2, Q3, Q4 Milestones)
model KpiPeriodicTarget {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                  @db.Uuid
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kpiId                 String                  @db.Uuid
  kpi                   KeyPerformanceIndicator @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  fiscalYearId          String                  @db.Uuid
  fiscalYear            FiscalYear              @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  periodKey             String                  @db.VarChar(32) // "ANNUAL", "Q1", "Q2", "Q3", "Q4"
  targetValue           Decimal                 @db.Decimal(14, 4)
  actualValue           Decimal?                @db.Decimal(14, 4)
  achievementPercent    Decimal?                @db.Decimal(7, 2)

  approvalRequests      ApprovalRequest[]
  appraisalItems        PerformanceAppraisalItem[]

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  @@unique([kpiId, fiscalYearId, periodKey])
  @@index([organizationId, kpiId])
  @@index([organizationId, fiscalYearId])
  @@index([organizationId, deletedAt])
  @@map("kpi_periodic_targets")
}

// Unit-Level Cascaded KPI Targets (Plan-to-Appraisal Closed Loop)
model UnitKpiTarget {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kpiId          String                  @db.Uuid
