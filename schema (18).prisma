  @@index([organizationId, deletedAt])
  @@map("organization_onboardings")
}

// Time-Boxed, Tenant-Approved Platform Support Access Grant
model SupportAccessGrant {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supportIdentityId      String                 @db.Uuid
  supportIdentity        Identity               @relation(fields: [supportIdentityId], references: [id], onDelete: Restrict)

  requestedReason        String                 @db.Text
  approvedByMembershipId String                 @db.Uuid
  approvedByMembership   OrganizationMembership @relation(fields: [approvedByMembershipId], references: [id], onDelete: Restrict)

  approvedAt             DateTime               @default(now()) @db.Timestamptz(6)
  expiresAt              DateTime               @db.Timestamptz(6)
  isRevoked              Boolean                @default(false)
  revokedAt              DateTime?              @db.Timestamptz(6)
  accessScope            String                 @default("DIAGNOSTIC_READ_ONLY") @db.VarChar(64)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)

  @@index([organizationId, supportIdentityId, expiresAt])
  @@index([organizationId, deletedAt])
  @@map("support_access_grants")
}

// ==============================================================================
// 11. INTERACTIVE ANALYTICS, BUSINESS INTELLIGENCE (BI) ENGINE & ROLLUP AGGREGATES
// ==============================================================================

enum WidgetChartType {
  METRIC_CARD
  BAR_CHART
  STACKED_BAR
  LINE_CHART
  AREA_CHART
  PIE_CHART
  DONUT_CHART
  RADAR_CHART
  D3_HEATMAP
  GAUGE_SPEEDOMETER
  DATA_GRID_TABLE
  SCATTER_PLOT
  FUNNEL_CHART
}

enum MetricAggregationType {
  SUM
  AVG
  COUNT
  MIN
  MAX
  WEIGHTED_AVG
  MEDIAN
  PERCENTILE_90
}

enum DashboardVisibility {
  PRIVATE_USER
  UNIT_SHARED
  ORGANIZATION_PUBLIC
  GROUP_CONSOLIDATED
}

enum AnalyticsDomain {
  EXECUTIVE_OVERVIEW
  STRATEGIC_PLAN_KPI
  DEPARTMENTAL_WORKPLAN
  PERFORMANCE_AGREEMENT
  ANNUAL_APPRAISAL
  RECRUITMENT_TALENT
  RISK_COMPLIANCE
  EVIDENCE_STORY_BANK
}

// Dynamic Custom Dashboard Layouts
model DashboardDefinition {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String              @db.Uuid
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                   String              @db.VarChar(64)
  title                  String              @db.VarChar(255)
  description            String?             @db.Text
  domain                 AnalyticsDomain     @default(EXECUTIVE_OVERVIEW)
  visibility             DashboardVisibility @default(ORGANIZATION_PUBLIC)
  isDefault              Boolean             @default(false)
  isSystemStandard       Boolean             @default(false)

  // Layout & Responsive Breakpoints
  layoutConfig           Json?               // [{i: "widget-1", x: 0, y: 0, w: 6, h: 4}]
  defaultFilters         Json?               // {fiscalYear: "FY-2025/2026", unitPath: "top.*"}
  refreshIntervalSeconds Int?                @default(300)

  authorMembershipId     String?             @db.Uuid
  authorMembership       OrganizationMembership? @relation("DashboardAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)

  deletedAt              DateTime?           @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)

  widgets                DashboardWidget[]
  savedViews             AnalyticsSavedView[]

  @@unique([organizationId, code])
  @@index([organizationId, domain])
  @@index([organizationId, visibility])
  @@index([organizationId, authorMembershipId])
  @@index([organizationId, deletedAt])
  @@map("dashboard_definitions")
}

// Configurable Dashboard Widget Parameters
model DashboardWidget {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                @db.Uuid
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dashboardId        String                @db.Uuid
  dashboard          DashboardDefinition   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  widgetCode         String                @db.VarChar(64)
  title              String                @db.VarChar(255)
  subtitle           String?               @db.VarChar(255)
  chartType          WidgetChartType       @default(BAR_CHART)
  aggregationType    MetricAggregationType @default(AVG)

  // Metrics, Dimensions & Calculations
  targetMetricField  String                @db.VarChar(128) // e.g. "compositeWeightedScore", "achievementPercent"
  dimensionField     String?               @db.VarChar(128) // e.g. "orgUnit.level", "gradingBand.gradeCode"
  filterCriteria     Json?                 // Drilldown criteria and threshold bands
  colorPalette       String?               @db.VarChar(64)

  // Grid Coordinate Placement
  gridPosX           Int                   @default(0)
  gridPosY           Int                   @default(0)
  gridWidth          Int                   @default(6)
  gridHeight         Int                   @default(4)
  minWidth           Int?                  @default(3)
  minHeight          Int?                  @default(2)

  dataSourceQuery    String?               @db.VarChar(128) // e.g. "rollup:department_execution"
  options            Json?                 // Tooltips, axis formatting, legends
  sortOrder          Int                   @default(1)

  deletedAt          DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)

  @@unique([dashboardId, widgetCode])
  @@index([organizationId, dashboardId])
  @@index([organizationId, chartType])
  @@index([organizationId, deletedAt])
  @@map("dashboard_widgets")
}

// Saved Views & Filter Presets for Instant Slice-and-Dice Drill-Downs
model AnalyticsSavedView {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String               @db.Uuid
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dashboardId         String?              @db.Uuid
  dashboard           DashboardDefinition? @relation(fields: [dashboardId], references: [id], onDelete: SetNull)

  viewName            String               @db.VarChar(150)
  viewCode            String               @db.VarChar(64)
  domain              AnalyticsDomain      @default(EXECUTIVE_OVERVIEW)
  isShared            Boolean              @default(false)
  isFavorite          Boolean              @default(false)

  authorMembershipId  String?              @db.Uuid
  authorMembership    OrganizationMembership? @relation("SavedViewAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)

  // Filter Preset Criteria
  fiscalYearCode      String?              @db.VarChar(32)
  orgUnitPathPrefix   String?              @db.VarChar(255) // ltree path filter: "top.dir_finance.*"
  selectedRoles       String[]
  filterPayload       Json                 // Full serializable filter facet tree
  columnPreferences   Json?                // Table columns, sort keys, visibility toggles

  deletedAt           DateTime?            @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, viewCode])
  @@index([organizationId, domain])
  @@index([organizationId, authorMembershipId])
  @@index([organizationId, deletedAt])
  @@map("analytics_saved_views")
}

// Analytical Summary Cache / Rollup Table: Departmental Execution Burn-Rate
model DepartmentExecutionRollup {
  id                          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String          @db.Uuid
  organization                Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fiscalYearId                String          @db.Uuid
  fiscalYear                  FiscalYear      @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  orgUnitId                   String          @db.Uuid
  orgUnit                     OrgUnit         @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  periodKey                   String          @db.VarChar(32) // "Q1", "Q2", "Q3", "Q4", "ANNUAL"

  // Activity & Milestone Aggregates
  totalMilestonesScheduled    Int             @default(0)
  milestonesCompletedOnTime   Int             @default(0)
  milestonesDelayed           Int             @default(0)
  burnRateExecutionPercent    Decimal         @default(0.00) @db.Decimal(5, 2)

  // Financial & Budgetary Metrics
  budgetAllocated             Decimal         @default(0.00) @db.Decimal(14, 2)
  budgetExpended              Decimal         @default(0.00) @db.Decimal(14, 2)
  budgetVariancePercent       Decimal?        @db.Decimal(6, 2)

  // Strategic KPI & Appraisal Metrics
  averageKpiAchievementRate   Decimal?        @db.Decimal(7, 2)
  averageAppraisalScore       Decimal?        @db.Decimal(5, 2)
  evidenceAttachedCount       Int             @default(0)
  verifiedEvidenceCount       Int             @default(0)

  asOfDate                    DateTime        @db.Date
  snapshotHash                String?         @db.VarChar(64)

  deletedAt                   DateTime?       @db.Timestamptz(6)
  refreshedAt                 DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, fiscalYearId, orgUnitId, periodKey])
  @@index([organizationId, fiscalYearId, periodKey])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, deletedAt])
  @@map("department_execution_rollups")
}

// Analytical Summary Cache / Rollup Table: Subsidiary Scorecard Aggregates
model SubsidiaryScorecardRollup {
  id                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                  String            @db.Uuid
  organization                    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  groupId                         String            @db.Uuid
  group                           OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  fiscalYearId                    String            @db.Uuid
  fiscalYear                      FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  calendarQuarter                 String            @db.VarChar(16) // "2025-Q3", "2025-Q4"

  totalStrategicObjectivesCount   Int               @default(0)
  alignedObjectivesCount          Int               @default(0)
  weightedGroupContributionScore  Decimal?          @db.Decimal(5, 2)
  consolidatedKpiIndex            Decimal?          @db.Decimal(7, 2)

  contractsExecutedCount          Int               @default(0)
  appraisalsClosedCount           Int               @default(0)

  reportingCurrency               String            @default("USD") @db.VarChar(8)
  currencyConversionRate          Decimal?          @default(1.000000) @db.Decimal(16, 6)

  asOfDate                        DateTime          @db.Date
  deletedAt                       DateTime?         @db.Timestamptz(6)
  refreshedAt                     DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([groupId, organizationId, fiscalYearId, calendarQuarter])
  @@index([groupId, calendarQuarter])
  @@index([organizationId, fiscalYearId])
  @@index([organizationId, deletedAt])
  @@map("subsidiary_scorecard_rollups")
}

// Analytical Summary Cache / Rollup Table: Appraisal Distribution Curves by Grading Band
model AppraisalDistributionRollup {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String        @db.Uuid
  organization               Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fiscalYearId               String        @db.Uuid
  fiscalYear                 FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  orgUnitId                  String?       @db.Uuid // NULL denotes entire Organization distribution
  orgUnit                    OrgUnit?      @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  gradingBandId              String        @db.Uuid
  gradingBand                GradingBand   @relation(fields: [gradingBandId], references: [id], onDelete: Cascade)

  periodKey                  String        @default("ANNUAL") @db.VarChar(32)
  cadre                      String?       @db.VarChar(64)

  appraisalCount             Int           @default(0)
  percentageOfPopulation     Decimal       @default(0.00) @db.Decimal(5, 2)
  targetQuotaPercent         Decimal?      @db.Decimal(5, 2) // e.g. 10.00%
  quotaDeviationPercent      Decimal?      @db.Decimal(5, 2)

  postCalibrationCount       Int?          @default(0)
  postCalibrationPercent     Decimal?      @db.Decimal(5, 2)

  asOfDate                   DateTime      @db.Date
  deletedAt                  DateTime?     @db.Timestamptz(6)
  refreshedAt                DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, fiscalYearId, orgUnitId, gradingBandId, periodKey])
  @@index([organizationId, fiscalYearId, periodKey])
  @@index([organizationId, gradingBandId])
  @@index([organizationId, deletedAt])
  @@map("appraisal_distribution_rollups")
}

