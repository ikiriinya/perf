  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobRoleCode         String                  @db.VarChar(64)
  jobTitle            String                  @db.VarChar(150)
  dutyCode            String                  @db.VarChar(32)
