// ==============================================================================
// PRISMA ORM SCHEMA - ENTERPRISE MULTI-TENANT GOVERNANCE & PERFORMANCE PLATFORM
// Target Database: PostgreSQL (Supabase / AWS RDS / GCP Cloud SQL)
// Version: Production-Grade 1.8.0 - Flexible Organization Structure & Tenant-Configured Hierarchies
//
// MODULE BREAKDOWN:
// 1. Tenancy, Group Holdings & Subsidiaries (Strict Isolation & Group Visibility Grants)
// 2. Global Identity, Role Definitions & Position Assignments (Tenant RBAC & Positions)
// 3. Flexible Org Structure: Tenant-Configured Unit Types, Rules & Closure Table
// 4. Unit Groups, Multi-Unit Programs, Committees & Taskforces
// 5. Multi-Source Strategic Plans, Group Strategy Cascades & Alignment
// 6. Recruitment, Talent Requisitions & Job Description Duty Frameworks
// 7. Month-by-Month Department/Unit Workplans & Cascaded UnitKpiTargets
// 8. Versioned Performance Contracts, Addendums, Numeric Items & Period-Keyed Appraisals
// 9. Moderation Calibration Sessions, Adjustments & Closed-Loop Appeals
// 10. Reusable Template Packs, Onboarding Clone Engine & Time-Boxed Support Grants
// 11. Interactive Analytics, Business Intelligence (BI) Engine & Rollup Aggregates
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 1. TENANCY, CORPORATE BRANDING, VISION, MISSION & MANDATES
// ==============================================================================

enum OrganizationType {
  PUBLIC_SECTOR_MINISTRY
  STATE_CORPORATION_AGENCY
  CONSTITUTIONAL_COMMISSION
  NON_PROFIT_INGO
  COUNTY_LOCAL_GOVERNMENT
  ENTERPRISE_HOLDING
}

enum OrganizationStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Organization {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String             @unique @db.VarChar(64)
  name                  String             @db.VarChar(255)
  legalName             String?            @db.VarChar(255)
  code                  String             @unique @db.VarChar(32)
  orgType               OrganizationType   @default(PUBLIC_SECTOR_MINISTRY)
  status                OrganizationStatus @default(ACTIVE)

  // Corporate Identity & Institutional Purpose
  tagline               String?            @db.VarChar(255) // e.g. "Service with Integrity, Impact with Evidence"
  vision                String?            @db.Text        // Long-term desired future state
  mission               String?            @db.Text        // Operational statement of purpose
  coreValues            Json?              // Array: [{code: "INT", name: "Integrity", definition: "...", behavior: "..."}]
  legalEstablishment    String?            @db.Text        // E.g. "Established pursuant to State Corporations Act Cap 446"
  citizenCharterSummary String?            @db.Text        // Citizen service delivery commitment summary
  citizenCharterUrl     String?            @db.Text

  // Corporate Branding & Visual Assets
  logoUrl               String?            @db.Text        // Primary institutional logo / crest (light bg)
  logoDarkUrl           String?            @db.Text        // Inverted logo for dark mode / headers
  faviconUrl            String?            @db.Text
  primaryColor          String             @default("#0F172A") @db.VarChar(16) // Main brand tone (Hex)
  secondaryColor        String             @default("#1E3A8A") @db.VarChar(16) // Complementary institutional color
  accentColor           String             @default("#D97706") @db.VarChar(16) // Action & highlight color
  brandThemeConfig      Json?              // Typography scale, border radii, white-label configs
  customDomain          String?            @unique @db.VarChar(128) // e.g. "governance.waterauthority.gov"

  // Contact & Localization
  websiteUrl            String?            @db.VarChar(255)
  primaryEmail          String             @db.VarChar(128)
  timezone              String             @default("UTC") @db.VarChar(64)
  currency              String             @default("USD") @db.VarChar(8)
  fiscalYearStart       Int                @default(7) // Month index (e.g. 7 for July 1st fiscal year)
  gradingScale          Json?              // Legacy fallback json configs
  settings              Json?              // Security, SLA timeouts, 2FA enforcement

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  // Tenant-isolated child collections (Phases 1-8 exhaustive coverage)
  mandates              OrganizationMandate[]
  fiscalYears           FiscalYear[]
  unitTypes             UnitType[]
  unitTypeRules         UnitTypeRule[]
  orgUnits              OrgUnit[]
  orgUnitClosures       OrgUnitClosure[]
  orgUnitVersions       OrgUnitVersion[]
  orgRestructureProposals OrgRestructureProposal[]
  unitGroupTypes        UnitGroupType[]
  unitGroups            UnitGroup[]
  unitGroupMembers      UnitGroupMember[]
  positions             Position[]
  positionAssignments   PositionAssignment[]
  roleDefinitions       RoleDefinition[]
  roleAssignments       RoleAssignment[]
  matrixGroups          MatrixGroup[]
  memberships           OrganizationMembership[]
  userAssignments       UserAssignment[]
  userDelegations       UserDelegation[]
  planSources           PlanSource[]
  strategicPillars      StrategicPillar[]
  strategicObjectives   StrategicObjective[]
  objectiveContributingUnits ObjectiveContributingUnit[]
  kpis                  KeyPerformanceIndicator[]
  kpiPeriodicTargets    KpiPeriodicTarget[]
  unitKpiTargets        UnitKpiTarget[]
  workplans             Workplan[]
  workplanActivities    WorkplanActivity[]
  workplanMonthlySchedules WorkplanMonthlySchedule[]
  performanceAgreements PerformanceAgreement[]
  performanceAgreementVersions PerformanceAgreementVersion[]
  performanceAgreementItems PerformanceAgreementItem[]
  performanceAgreementAddendums PerformanceAgreementAddendum[]
  performanceAppraisals PerformanceAppraisal[]
  performanceAppraisalItems PerformanceAppraisalItem[]
  scoringRules          ScoringRule[]
  gradingScales         GradingScale[]
  gradingBands          GradingBand[]
  jobDescriptionDuties  JobDescriptionDuty[]
  competencies          Competency[]
  competencyRatings     CompetencyRating[]
  recruitmentRequisitions RecruitmentRequisition[]
  candidateApplicants   CandidateApplicant[]
  calibrationSessions   CalibrationSession[]
  calibrationAdjustments CalibrationAdjustment[]
  appraisalAppeals      PerformanceAppraisalAppeal[]
  evidenceCategories    EvidenceCategory[]
  approvalRequestKinds  ApprovalRequestKind[]
  approvalWorkflows     ApprovalWorkflow[]
  approvalStageConfigs  ApprovalStageConfig[]
  workflowStageConditions WorkflowStageCondition[]
  approvalRequests      ApprovalRequest[]
  approvalActions       ApprovalAction[]
  auditTrails           AuditTrail[]
  storyBankEntries      StoryBankEntry[]
  evidenceAttachments   EvidenceAttachment[]
  strategicPlanMatrixRows StrategicPlanMatrixRow[]

  // Analytics & Business Intelligence Engine Collections
  dashboards                  DashboardDefinition[]
  dashboardWidgets            DashboardWidget[]
  savedViews                  AnalyticsSavedView[]
  departmentExecutionRollups  DepartmentExecutionRollup[]
  subsidiaryScorecardRollups  SubsidiaryScorecardRollup[]
  appraisalDistributionRollups AppraisalDistributionRollup[]

  // Phase 6 Group & Template Collections
  ownedGroups           OrganizationGroup[]          @relation("GroupOwner")
  groupMemberships      OrganizationGroupMember[]    @relation("GroupMemberOrganizations")
  grantedVisibilityGrants VisibilityGrant[]          @relation("GrantedVisibilityGrants")
  subsidiaryAlignments  SubsidiaryObjectiveAlignment[]
  periodMappings        GroupPeriodMapping[]
  onboardingRecord      OrganizationOnboarding?      @relation("OrganizationOnboarding")
  clonedSubsidiaries    OrganizationOnboarding[]     @relation("ClonedFromParentOnboarding")
  supportGrants         SupportAccessGrant[]

  @@index([status])
  @@index([orgType])
  @@index([status, deletedAt])
  @@map("organizations")
}

// Statutory, Constitutional & Legal Mandates of the Company / Institution
enum MandateCategory {
  CONSTITUTIONAL_CORE        // Sovereign / constitutional mandate
  STATUTORY_ACT              // Primary statutory enabling legislation
  EXECUTIVE_ORDER            // Gazette notice / presidential / ministerial directive
  REGULATORY_OVERSIGHT       // Industry licensing & regulatory enforcement
  SERVICE_DELIVERY_CHARTER   // Citizen service delivery covenant
}

model OrganizationMandate {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @db.Uuid
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category             MandateCategory    @default(STATUTORY_ACT)
  title                String             @db.VarChar(255)
  legalReference       String             @db.VarChar(255)
  summaryDescription   String             @db.Text
  fullTextOrClauses    String?            @db.Text
  gazetteNoticeNumber  String?            @db.VarChar(100)
  effectiveDate        DateTime           @db.Date
  expiryDate           DateTime?          @db.Date
  isActive             Boolean            @default(true)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  strategicObjectives  StrategicObjective[]

  @@unique([organizationId, legalReference])
  @@index([organizationId, category])
  @@index([organizationId, deletedAt])
  @@map("organization_mandates")
}

// ==============================================================================
// 1B. GROUP STRUCTURE, SUBSIDIARIES & VISIBILITY GRANTS (PHASE 6)
// ==============================================================================

enum GroupRelationshipType {
  PARENT
  SUBSIDIARY
  AFFILIATE
}

model OrganizationGroup {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                    @unique @db.VarChar(32)
  name                String                    @db.VarChar(255)
  ownerOrganizationId String                    @db.Uuid
  ownerOrganization   Organization              @relation("GroupOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  reportingCurrency   String                    @default("USD") @db.VarChar(8)
  description         String?                   @db.Text

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(6)

  members             OrganizationGroupMember[]
  groupMemberships    GroupMembership[]
  visibilityGrants    VisibilityGrant[]
  groupObjectives     GroupObjective[]
  periodMappings      GroupPeriodMapping[]
  subsidiaryScorecardRollups SubsidiaryScorecardRollup[]

  @@index([ownerOrganizationId])
  @@index([deletedAt])
  @@map("organization_groups")
}

model OrganizationGroupMember {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId               String                @db.Uuid
  group                 OrganizationGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  organizationId        String                @db.Uuid
  organization          Organization          @relation("GroupMemberOrganizations", fields: [organizationId], references: [id], onDelete: Restrict)

  relationshipType      GroupRelationshipType @default(SUBSIDIARY)
  ownershipStakePercent Decimal?              @default(100.00) @db.Decimal(5, 2)
  isConsolidated        Boolean               @default(true)
  effectiveFrom         DateTime              @default(now()) @db.Date
  effectiveTo           DateTime?             @db.Date

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(6)

  @@unique([groupId, organizationId])
  @@index([organizationId])
  @@index([groupId])
  @@index([organizationId, deletedAt])
  @@map("organization_group_members")
}

enum GroupRole {
  GROUP_ADMIN
  GROUP_VIEWER
}

model GroupMembership {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId  String            @db.Uuid
  identity    Identity          @relation(fields: [identityId], references: [id], onDelete: Restrict)

  groupId     String            @db.Uuid
  group       OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  role        GroupRole         @default(GROUP_VIEWER)
  status      UserStatus        @default(ACTIVE)

  grantedAt   DateTime          @default(now()) @db.Timestamptz(6)
  revokedAt   DateTime?         @db.Timestamptz(6)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([identityId, groupId])
  @@index([identityId])
  @@index([groupId])
  @@index([groupId, deletedAt])
  @@map("group_memberships")
}

enum GrantResourceType {
  SCORECARD
  STRATEGIC_PLAN
  KPI_ACTUALS
  WORKPLAN_SUMMARY
  APPRAISAL_AGGREGATE
}

enum GrantAccessLevel {
  NONE
  SUMMARY
  DETAIL
}

model VisibilityGrant {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantingOrganizationId String                 @db.Uuid
  grantingOrganization   Organization           @relation("GrantedVisibilityGrants", fields: [grantingOrganizationId], references: [id], onDelete: Restrict)

  groupId                String                 @db.Uuid
  group                  OrganizationGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  resourceType           GrantResourceType
  accessLevel            GrantAccessLevel       @default(SUMMARY)

  effectiveFrom          DateTime               @default(now()) @db.Timestamptz(6)
  effectiveTo            DateTime?              @db.Timestamptz(6)

  grantedByMembershipId  String                 @db.Uuid
  grantedByMembership    OrganizationMembership @relation(fields: [grantedByMembershipId], references: [id], onDelete: Restrict)

  reason                 String?                @db.Text
  isRevoked              Boolean                @default(false)
  revokedAt              DateTime?              @db.Timestamptz(6)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([grantingOrganizationId, groupId, resourceType])
  @@index([grantingOrganizationId])
  @@index([groupId])
  @@index([deletedAt])
  @@map("visibility_grants")
}

// Multi-Currency Exchange Rates for Group Roll-Ups
model CurrencyRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrency  String   @db.VarChar(8)
  toCurrency    String   @db.VarChar(8)
  rate          Decimal  @db.Decimal(16, 6)
  effectiveDate DateTime @db.Date
  source        String    @default("CENTRAL_BANK") @db.VarChar(64)
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency, effectiveDate])
  @@index([deletedAt])
  @@map("currency_rates")
}

// Fiscal Year / Calendar Quarter Alignment Mapping
model GroupPeriodMapping {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId         String            @db.Uuid
  group           OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  organizationId  String            @db.Uuid
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  fiscalYearId    String            @db.Uuid
  fiscalYear      FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  localPeriodKey  String            @db.VarChar(32) // "Q1", "Q2", "Q3", "Q4", "ANNUAL"
  calendarQuarter String            @db.VarChar(16) // "2025-Q3", "2025-Q4", "2026-Q1"
  startDate       DateTime          @db.Date
  endDate         DateTime          @db.Date

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, localPeriodKey, calendarQuarter])
  @@index([groupId, calendarQuarter])
  @@index([organizationId, deletedAt])
  @@map("group_period_mappings")
}

// Group-Level Strategy & Cascade Objectives
model GroupObjective {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId           String                @db.Uuid
  group             OrganizationGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  code              String                @db.VarChar(32)
  title             String                @db.VarChar(255)
  description       String?               @db.Text
  kpiName           String                @db.VarChar(255)
  kpiUnit           String                @db.VarChar(32)
  targetValue       Decimal               @db.Decimal(14, 4)
  calculationMethod KpiCalculationMethod  @default(SUM_CUMULATIVE)
  targetCurrency    String?               @default("USD") @db.VarChar(8)
  reportingYear     String                @db.VarChar(32)
  status            String                @default("ACTIVE") @db.VarChar(32)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)

  alignments        SubsidiaryObjectiveAlignment[]

  @@unique([groupId, code])
  @@index([groupId, deletedAt])
  @@map("group_objectives")
}

model SubsidiaryObjectiveAlignment {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupObjectiveId     String                 @db.Uuid
  groupObjective       GroupObjective         @relation(fields: [groupObjectiveId], references: [id], onDelete: Cascade)

  strategicObjectiveId String                 @db.Uuid
  strategicObjective   StrategicObjective     @relation(fields: [strategicObjectiveId], references: [id], onDelete: Restrict)

  kpiId                String?                @db.Uuid
  kpi                  KeyPerformanceIndicator? @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  organizationId       String                 @db.Uuid
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  contributionWeight   Decimal                @default(100.00) @db.Decimal(5, 2)
  status               String                 @default("ACTIVE") @db.VarChar(32)
  alignedAt            DateTime               @default(now()) @db.Timestamptz(6)

  alignedByMembershipId String                @db.Uuid
  alignedByMembership  OrganizationMembership @relation(fields: [alignedByMembershipId], references: [id], onDelete: Restrict)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([groupObjectiveId, strategicObjectiveId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("subsidiary_objective_alignments")
}

// Multi-Year Institutional Accounting Cycles & Statutory Audit Calendars
enum FiscalYearStatus {
  PLANNING
  ACTIVE
  CLOSED_AUDIT_PENDING
  ARCHIVED_FINAL
}

model FiscalYear {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String            @db.Uuid
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  code                 String            @db.VarChar(32) // e.g. "FY-2025/2026"
  name                 String            @db.VarChar(100) // e.g. "Fiscal Year 2025-2026"
  startDate            DateTime          @db.Date
  endDate              DateTime          @db.Date
  status               FiscalYearStatus  @default(PLANNING)
  isCurrent            Boolean           @default(false)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)

  planSources          PlanSource[]
  workplans            Workplan[]
  performanceAgreements PerformanceAgreement[]
  kpiPeriodicTargets   KpiPeriodicTarget[]
  unitKpiTargets       UnitKpiTarget[]
  calibrationSessions  CalibrationSession[]
  storyBankEntries     StoryBankEntry[]
  periodMappings       GroupPeriodMapping[]
  departmentExecutionRollups DepartmentExecutionRollup[]
  subsidiaryScorecardRollups SubsidiaryScorecardRollup[]
  appraisalDistributionRollups AppraisalDistributionRollup[]

  @@unique([organizationId, code])
  @@index([organizationId, isCurrent])
  @@index([organizationId, deletedAt])
  @@map("fiscal_years")
}

// ==============================================================================
// 3. FLEXIBLE ORG STRUCTURE: TENANT-CONFIGURED UNIT TYPES, RULES & CLOSURES
// ==============================================================================

enum OrgUnitStatus {
  ACTIVE
  RESTRUCTURING
  DECOMMISSIONED
}

// Configurable organizational tiers per tenant (e.g. Ministry, Directorate, Department, Section)
model UnitType {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                  String             @db.VarChar(32) // e.g. "MINISTRY", "DIRECTORATE", "DEPARTMENT", "SECTION"
  name                  String             @db.VarChar(128) // e.g. "State Department", "Directorate", "Department"
  pluralName            String             @db.VarChar(128) // e.g. "State Departments", "Directorates", "Departments"
  icon                  String?            @db.VarChar(64) // e.g. "Building2", "Layers", "FolderTree", "Briefcase"
  sortRank              Int                @default(1) // Visual hierarchy tier (1 = top-most)

  // Behavioral capability flags
  canHoldWorkplan       Boolean            @default(true)
  canHoldHeadcount      Boolean            @default(true)
  canSignAgreements     Boolean            @default(true)
  isHorizontal          Boolean            @default(false)

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  orgUnits              OrgUnit[]
  orgUnitVersions       OrgUnitVersion[]
  childRules            UnitTypeRule[]     @relation("ParentUnitTypeRules")
  parentRules           UnitTypeRule[]     @relation("ChildUnitTypeRules")
  approvalStageConfigs  ApprovalStageConfig[]

  @@unique([organizationId, code])
  @@index([organizationId, sortRank])
  @@index([organizationId, deletedAt])
  @@map("unit_types")
}

// Permitted structural parent-to-child containment rules
model UnitTypeRule {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parentUnitTypeId      String             @db.Uuid
  parentUnitType        UnitType           @relation("ParentUnitTypeRules", fields: [parentUnitTypeId], references: [id], onDelete: Cascade)

  childUnitTypeId       String             @db.Uuid
  childUnitType         UnitType           @relation("ChildUnitTypeRules", fields: [childUnitTypeId], references: [id], onDelete: Cascade)

  maxChildren           Int?               // Optional limit on direct children of this type under parent
  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, parentUnitTypeId, childUnitTypeId])
  @@index([organizationId, parentUnitTypeId])
  @@index([organizationId, childUnitTypeId])
  @@index([organizationId, deletedAt])
  @@map("unit_type_rules")
}

// Dynamic Org Chart Node linked to configurable UnitType
model OrgUnit {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                  String             @db.VarChar(32)
  name                  String             @db.VarChar(255)
  shortName             String?            @db.VarChar(64)
  description           String?            @db.Text
  status                OrgUnitStatus      @default(ACTIVE)

  // Tenant-configured structural classification
  unitTypeId            String             @db.Uuid
  unitType              UnitType           @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)

  // Self-relation tree for direct parent-child navigation
  parentId              String?            @db.Uuid
  parent                OrgUnit?           @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children              OrgUnit[]          @relation("OrgUnitHierarchy")

  // Temporal Validity
  effectiveFrom         DateTime           @default(now()) @db.Date
  effectiveTo           DateTime?          @db.Date

  // Unit Head / Lead User (Denormalized current pointer to OrganizationMembership)
  headMembershipId      String?            @db.Uuid
  headMembership        OrganizationMembership? @relation("OrgUnitLeadership", fields: [headMembershipId], references: [id], onDelete: SetNull)

  // Horizontal Cross-Cutting Linkage (legacy matrix groups)
  matrixGroupId         String?            @db.Uuid
  matrixGroup           MatrixGroup?       @relation(fields: [matrixGroupId], references: [id], onDelete: SetNull)

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  // Closure Table Relations (Subtree queries & depth lookups)
  closuresAsAncestor    OrgUnitClosure[]   @relation("AncestorClosures")
  closuresAsDescendant  OrgUnitClosure[]   @relation("DescendantClosures")

  // Positions & Roles in Unit
  positions             Position[]
  scopedRoleAssignments RoleAssignment[]   @relation("TargetUnitRoleAssignments")
  unitGroupMemberships  UnitGroupMember[]

  // Operational & Governance Relations
  homeMembers           OrganizationMembership[] @relation("MembershipHomeUnit")
  historicalAssignments UserAssignment[]
  versions              OrgUnitVersion[]
  delegations           UserDelegation[]
  ledStrategicObjectives StrategicObjective[]     @relation("LeadUnitObjectives")
  contributedObjectives  ObjectiveContributingUnit[]
  workplans              Workplan[]
  storyBankEntries       StoryBankEntry[]
  performanceAgreements  PerformanceAgreement[]
  unitKpiTargets         UnitKpiTarget[]
  calibrationSessions    CalibrationSession[]
  restructureApprovalRequests ApprovalRequest[]   @relation("OrgUnitRestructureApprovals")
  recruitmentRequisitions RecruitmentRequisition[]
  departmentExecutionRollups DepartmentExecutionRollup[]
  appraisalDistributionRollups AppraisalDistributionRollup[]

  @@unique([organizationId, code])
  @@index([organizationId, unitTypeId])
  @@index([organizationId, parentId])
  @@index([organizationId, deletedAt])
  @@map("org_units")
}

// Maintained via database triggers: Fast O(1) subtree retrieval and ancestor tree rollups
model OrgUnitClosure {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ancestorId            String             @db.Uuid
  ancestor              OrgUnit            @relation("AncestorClosures", fields: [ancestorId], references: [id], onDelete: Cascade)

  descendantId          String             @db.Uuid
  descendant            OrgUnit            @relation("DescendantClosures", fields: [descendantId], references: [id], onDelete: Cascade)

  depth                 Int                @default(0) // 0 = self, 1 = direct child, 2 = grandchild...

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, ancestorId, descendantId])
  @@index([organizationId, ancestorId, depth])
  @@index([organizationId, descendantId, depth])
  @@index([organizationId, deletedAt])
  @@map("org_unit_closures")
}

// Historical point-in-time snapshot of an OrgUnit as it existed during past fiscal cycles
model OrgUnitVersion {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                 @db.Uuid
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orgUnitId             String                 @db.Uuid
  orgUnit               OrgUnit                @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  versionNo             Int                    @default(1)
  name                  String                 @db.VarChar(255)
  shortName             String?                @db.VarChar(64)
  unitTypeId            String?                @db.Uuid
  unitType              UnitType?              @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  parentOrgUnitId       String?                @db.Uuid
  headMembershipId      String?                @db.Uuid

  effectiveFrom         DateTime               @db.Date
  effectiveTo           DateTime?              @db.Date
  isCurrent             Boolean                @default(true)

  restructureProposalId String?                @db.Uuid
  restructureProposal   OrgRestructureProposal? @relation(fields: [restructureProposalId], references: [id], onDelete: SetNull)
  changeSummary         String?                @db.Text

  deletedAt             DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([orgUnitId, versionNo])
  @@index([organizationId, orgUnitId, isCurrent])
  @@index([organizationId, deletedAt])
  @@map("org_unit_versions")
}

enum RestructureProposalStatus {
  PROPOSED
  IN_REVIEW
  APPROVED
  IMPLEMENTED
  REJECTED
  CANCELLED
}

// Formal restructuring proposal enabling historical workplans to retain integrity
model OrgRestructureProposal {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                    @db.Uuid
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  proposalCode          String                    @db.VarChar(64) // e.g. "RESTRUCT-2026-001"
  title                 String                    @db.VarChar(255)
  justification         String                    @db.Text
  proposedEffectiveDate DateTime                  @db.Date
  status                RestructureProposalStatus @default(PROPOSED)

  submittedByMembershipId String                  @db.Uuid
  submittedByMembership   OrganizationMembership  @relation("RestructureProposer", fields: [submittedByMembershipId], references: [id], onDelete: Restrict)

  approvedAt            DateTime?                 @db.Timestamptz(6)
  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)

  orgUnitVersions       OrgUnitVersion[]
  approvalRequests      ApprovalRequest[]

  @@unique([organizationId, proposalCode])
  @@index([organizationId, deletedAt])
  @@map("org_restructure_proposals")
}

// Horizontal Cross-Cutting Groups / Committees (Matrix Governance)
model MatrixGroup {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code           String       @db.VarChar(32)
  name           String       @db.VarChar(255) // e.g. "ESG Oversight Committee", "Digital Transformation Taskforce"
  purpose        String?      @db.Text
  coordinatorMembershipId String? @db.Uuid
  coordinator    OrganizationMembership? @relation("MatrixGroupCoordinator", fields: [coordinatorMembershipId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  orgUnits       OrgUnit[]
  members        OrganizationMembership[] @relation("MatrixGroupMembers")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("matrix_groups")
}

// ==============================================================================
// 4. UNIT GROUPS, MULTI-UNIT PROGRAMS, COMMITTEES & TASKFORCES
// ==============================================================================

enum UnitGroupMemberRole {
  LEAD
  SUPPORTING
}

// Configurable classification for horizontal initiatives (e.g. Committee, Program, Taskforce, Council)
model UnitGroupType {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                  String             @db.VarChar(32) // e.g. "PROGRAM", "COMMITTEE", "TASKFORCE"
  name                  String             @db.VarChar(128)
  description           String?            @db.Text

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  groups                UnitGroup[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("unit_group_types")
}

// Cross-cutting group, program, committee or taskforce spanning multiple units
model UnitGroup {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  typeId                String             @db.Uuid
  type                  UnitGroupType      @relation(fields: [typeId], references: [id], onDelete: Restrict)

  code                  String             @db.VarChar(32) // e.g. "PRG-DIGITAL-TRANSFORM", "CMTE-AUDIT-RISK"
  name                  String             @db.VarChar(255)
  charter               String?            @db.Text
  effectiveFrom         DateTime           @default(now()) @db.Date
  effectiveTo           DateTime?          @db.Date
  isActive              Boolean            @default(true)

  coordinatorMembershipId String?          @db.Uuid
  coordinator           OrganizationMembership? @relation("UnitGroupCoordinator", fields: [coordinatorMembershipId], references: [id], onDelete: SetNull)

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  members               UnitGroupMember[]

  @@unique([organizationId, code])
  @@index([organizationId, typeId])
  @@index([organizationId, deletedAt])
  @@map("unit_groups")
}

// Member of a UnitGroup: can be an OrgUnit or an individual OrganizationMembership
// Supports multiple LEAD units (e.g. joint programs) plus SUPPORTING units
model UnitGroupMember {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  groupId               String             @db.Uuid
  group                 UnitGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Polymorphic association: unit-level membership or individual membership
  unitId                String?            @db.Uuid
  unit                  OrgUnit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId          String?            @db.Uuid
  membership            OrganizationMembership? @relation("UnitGroupMemberships", fields: [membershipId], references: [id], onDelete: Cascade)

  role                  UnitGroupMemberRole @default(SUPPORTING) // LEAD or SUPPORTING
  title                 String?            @db.VarChar(128) // Specific function in group (e.g. "Joint Lead", "Technical Secretariat")

  effectiveFrom         DateTime           @default(now()) @db.Date
  effectiveTo           DateTime?          @db.Date

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  @@index([organizationId, groupId, role])
  @@index([organizationId, unitId])
  @@index([organizationId, membershipId])
  @@index([organizationId, deletedAt])
  @@map("unit_group_members")
}

// ==============================================================================
// 5. POSITIONS, POSITION ASSIGNMENTS & REPORTING LINES
// ==============================================================================

// Defined post/establishment seat within an OrgUnit (e.g. Director of Finance, Senior Auditor)
model Position {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  unitId                String             @db.Uuid
  unit                  OrgUnit            @relation(fields: [unitId], references: [id], onDelete: Restrict)

  code                  String             @db.VarChar(64) // e.g. "POS-FIN-DIR-001"
  title                 String             @db.VarChar(150) // e.g. "Director of Corporate Finance"
  isUnitHead            Boolean            @default(false)
  jobGradeCode          String?            @db.VarChar(32)
  fte                   Decimal            @default(1.00) @db.Decimal(4, 2)

  // Position reporting line (reports to higher position)
  reportsToPositionId   String?            @db.Uuid
  reportsToPosition     Position?          @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: Restrict)
  subordinatePositions  Position[]         @relation("PositionHierarchy")

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  assignments           PositionAssignment[]
  roleAssignments       RoleAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, unitId])
  @@index([organizationId, reportsToPositionId])
  @@index([organizationId, deletedAt])
  @@map("positions")
}

// Assignment of an OrganizationMembership to a Position with acting/substantive flags
model PositionAssignment {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  positionId            String             @db.Uuid
  position              Position           @relation(fields: [positionId], references: [id], onDelete: Cascade)

  membershipId          String             @db.Uuid
  membership            OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  effectiveFrom         DateTime           @default(now()) @db.Date
  effectiveTo           DateTime?          @db.Date // NULL = active/current assignment
  isActing              Boolean            @default(false)
  isPrimary             Boolean            @default(true)

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  approvalActions       ApprovalAction[]

  @@index([organizationId, positionId])
  @@index([organizationId, membershipId, effectiveTo])
  @@index([organizationId, deletedAt])
  @@map("position_assignments")
}

// ==============================================================================
// 6. TENANT-CONFIGURED ROLE DEFINITIONS & SCOPED ROLE ASSIGNMENTS
// ==============================================================================

enum RoleAssignmentScope {
  SELF
  THIS_UNIT
  UNIT_AND_BELOW
  ORGANIZATION
}

// Tenant-configured role definition with granular permission keys (replaces static SystemRole enum)
model RoleDefinition {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                  String             @db.VarChar(64) // e.g. "ORG_ADMIN", "DEPT_HEAD", "STRATEGIC_PLANNER"
  name                  String             @db.VarChar(128)
  description           String?            @db.Text
  isSystem              Boolean            @default(false) // Core out-of-the-box role vs customized
  permissionKeys        String[]           // Array of granular permissions e.g. ["workplan:approve", "agreement:sign"]

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  roleAssignments       RoleAssignment[]
  approvalStageConfigs  ApprovalStageConfig[]  @relation("StageApproverRole")
  fallbackStageConfigs  ApprovalStageConfig[]  @relation("FallbackRoleStages")
  escalationStageConfigs ApprovalStageConfig[] @relation("EscalationRoleStages")
  userAssignments       UserAssignment[]
  userDelegations       UserDelegation[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("role_definitions")
}

// Scoped role assignment granted to either a Position or directly to an OrganizationMembership
model RoleAssignment {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String             @db.Uuid
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleDefinitionId      String             @db.Uuid
  roleDefinition        RoleDefinition     @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)

  // Assigned to position OR directly to membership
  positionId            String?            @db.Uuid
  position              Position?          @relation(fields: [positionId], references: [id], onDelete: Cascade)

  membershipId          String?            @db.Uuid
  membership            OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  // Scope determines boundary of authority
  scope                 RoleAssignmentScope @default(THIS_UNIT)

  // Optional target unit for scoped assignments
  targetUnitId          String?            @db.Uuid
  targetUnit            OrgUnit?           @relation("TargetUnitRoleAssignments", fields: [targetUnitId], references: [id], onDelete: SetNull)

  effectiveFrom         DateTime           @default(now()) @db.Date
  effectiveTo           DateTime?          @db.Date

  deletedAt             DateTime?          @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  @@index([organizationId, roleDefinitionId])
  @@index([organizationId, positionId])
  @@index([organizationId, membershipId])
  @@index([organizationId, targetUnitId])
  @@index([organizationId, deletedAt])
  @@map("role_assignments")
}

enum UserStatus {
  ACTIVE
  ON_PROBATION
  ON_LEAVE
  SECONDED
  SUSPENDED
  OFFBOARDED
}

// Global Single Source of Identity (Federated across all organizations/subsidiaries)
model Identity {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseAuthId  String?       @unique @db.Uuid
  primaryEmail    String        @unique @db.VarChar(255)
  firstName       String        @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  phoneNumber     String?       @db.VarChar(32)
  avatarUrl       String?       @db.Text
  isPlatformAdmin Boolean       @default(false)

  deletedAt       DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  memberships     OrganizationMembership[]
  groupMemberships GroupMembership[]
  supportGrants   SupportAccessGrant[]

  @@index([primaryEmail])
  @@index([primaryEmail, deletedAt])
  @@map("identities")
}

// Tenant-Scoped Employment / Mandate Membership (Strict single active home unit enforced)
model OrganizationMembership {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId           String        @db.Uuid
  identity             Identity      @relation(fields: [identityId], references: [id], onDelete: Restrict)

  organizationId       String        @db.Uuid
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  employeeNumber       String        @db.VarChar(64)
  jobTitle             String        @db.VarChar(150)

  // Single active home unit strictly maintained per membership
  homeUnitId           String        @db.Uuid
  homeUnit             OrgUnit       @relation("MembershipHomeUnit", fields: [homeUnitId], references: [id], onDelete: Restrict)

  roleCode             String?       @default("EMPLOYEE") @db.VarChar(64)
  status               UserStatus    @default(ACTIVE)

  directSupervisorMembershipId String? @db.Uuid
  directSupervisor     OrganizationMembership? @relation("MembershipSupervision", fields: [directSupervisorMembershipId], references: [id], onDelete: SetNull)
  subordinates         OrganizationMembership[] @relation("MembershipSupervision")

  jobRoleCode          String?       @db.VarChar(64)
  jobDescription       String?       @db.Text

  deletedAt            DateTime?     @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  // Flexible Org Structure: Positions, Role Assignments & Unit Groups
  positionAssignments PositionAssignment[]
  roleAssignments     RoleAssignment[]
  unitGroupMemberships UnitGroupMember[]     @relation("UnitGroupMemberships")
  coordinatedUnitGroups UnitGroup[]          @relation("UnitGroupCoordinator")

  // Talent, Recruitment & Job Frameworks
  assignedDuties            JobDescriptionDuty[]  @relation("MembershipAssignedDuties")
  managedRequisitions       RecruitmentRequisition[] @relation("RequisitionHiringManager")
  deployedFromApplicants    CandidateApplicant[]  @relation("ApplicantDeployedMembership")

  // Analytics & Custom Dashboards
  createdDashboards         DashboardDefinition[] @relation("DashboardAuthor")
  savedViews                AnalyticsSavedView[]  @relation("SavedViewAuthor")

  // Effective-Dated Assignment Ledger
  assignments          UserAssignment[]      @relation("MembershipAssignments")
  supervisedAssignments UserAssignment[]     @relation("SupervisorAssignments")

  // Leadership & Assignments
  ledOrgUnits               OrgUnit[]             @relation("OrgUnitLeadership")
  coordinatedMatrixGroups   MatrixGroup[]         @relation("MatrixGroupCoordinator")
  memberMatrixGroups        MatrixGroup[]         @relation("MatrixGroupMembers")
  activeDelegationsAsActing UserDelegation[]      @relation("DelegatedActingMembership")
  activeDelegationsAsOwner  UserDelegation[]      @relation("DelegatingSubstantiveMembership")

  // Core Operational Relations
  leadActivities            WorkplanActivity[]    @relation("ActivityLeadMembership")
  performerAgreements       PerformanceAgreement[] @relation("PerformerAgreement")
  supervisedAgreements      PerformanceAgreement[] @relation("SupervisorAgreement")
  countersigningAgreements   PerformanceAgreement[] @relation("CountersigningAgreement")

  performerAppraisals       PerformanceAppraisal[] @relation("PerformerAppraisal")
  supervisedAppraisals      PerformanceAppraisal[] @relation("SupervisorAppraisal")
  countersignedAppraisals   PerformanceAppraisal[] @relation("CountersigningAppraisal")

  // Governance, Calibration, Appeals & Approvals
  chairedCalibrationSessions CalibrationSession[]  @relation("CalibrationChair")
  approvedCalibrationAdjustments CalibrationAdjustment[] @relation("CalibrationApprover")
  appellantAppeals          PerformanceAppraisalAppeal[] @relation("AppraisalAppellant")
  determinedAppeals         PerformanceAppraisalAppeal[] @relation("AppealDeterminer")
  submittedApprovals        ApprovalRequest[]     @relation("ApprovalRequester")
  approvalActions           ApprovalAction[]
  substantiveApprovalActions ApprovalAction[]    @relation("DelegatedApprovalSubstantive")
  assignedApprovalStages    ApprovalStageConfig[] @relation("DesignatedStageApprover")
  submittedRestructureProposals OrgRestructureProposal[] @relation("RestructureProposer")
  approvedAgreementAddendums PerformanceAgreementAddendum[] @relation("AddendumApprover")

  // Evidence & Story Bank
  verifiedStoryEntries      StoryBankEntry[]      @relation("StoryAuditor")
  uploadedAttachments       EvidenceAttachment[]  @relation("AttachmentUploader")
  verifiedEvidence          EvidenceAttachment[]  @relation("EvidenceVerifier")
  auditActions              AuditTrail[]

  // Group & Platform Admin Relations
  grantedVisibilityGrants   VisibilityGrant[]
  appliedOnboardings        OrganizationOnboarding[]
  alignedObjectives         SubsidiaryObjectiveAlignment[]
  approvedSupportGrants     SupportAccessGrant[]

  @@unique([identityId, organizationId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, homeUnitId])
  @@index([organizationId, roleCode])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("organization_memberships")
}

// Effective-Dated Employment & Deployment Ledger
model UserAssignment {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                 @db.Uuid
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  membershipId         String                 @db.Uuid
  membership           OrganizationMembership @relation("MembershipAssignments", fields: [membershipId], references: [id], onDelete: Cascade)

  orgUnitId            String                 @db.Uuid
  orgUnit              OrgUnit                @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  jobTitle             String                 @db.VarChar(150)
  roleCode             String?                @default("EMPLOYEE") @db.VarChar(64)
  roleDefinitionId     String?                @db.Uuid
  roleDefinition       RoleDefinition?        @relation(fields: [roleDefinitionId], references: [id], onDelete: SetNull)

  directSupervisorMembershipId String?        @db.Uuid
  directSupervisor     OrganizationMembership? @relation("SupervisorAssignments", fields: [directSupervisorMembershipId], references: [id], onDelete: SetNull)

  effectiveFrom        DateTime               @db.Date
  effectiveTo          DateTime?              @db.Date // NULL denotes currently open/active assignment
  isCurrent            Boolean                @default(true)
  assignmentReason     String?                @db.Text // e.g. "Initial appointment", "Promotion", "Lateral Transfer"

  deletedAt            DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)

  @@index([organizationId, membershipId, isCurrent])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, roleDefinitionId])
  @@index([organizationId, deletedAt])
  @@map("user_assignments")
}

// Temporary Acting / Delegated Authorities with strict audit validity windows
model UserDelegation {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String                 @db.Uuid
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  substantiveMembershipId  String                 @db.Uuid
  substantiveMembership    OrganizationMembership @relation("DelegatingSubstantiveMembership", fields: [substantiveMembershipId], references: [id], onDelete: Cascade)

  actingMembershipId       String                 @db.Uuid
  actingMembership         OrganizationMembership @relation("DelegatedActingMembership", fields: [actingMembershipId], references: [id], onDelete: Cascade)

  targetOrgUnitId          String                 @db.Uuid
  targetOrgUnit            OrgUnit                @relation(fields: [targetOrgUnitId], references: [id], onDelete: Cascade)

  actingRoleCode           String?                @db.VarChar(64)
  actingRoleDefinitionId   String?                @db.Uuid
  actingRoleDefinition     RoleDefinition?        @relation(fields: [actingRoleDefinitionId], references: [id], onDelete: SetNull)

  reason                   String                 @db.Text // e.g. "Annual leave cover", "Interim Acting appointment"
  startDate                DateTime               @db.Date
  endDate                  DateTime               @db.Date
  isActive                 Boolean                @default(true)

  deletedAt                DateTime?              @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)

  approvalActions          ApprovalAction[]

  @@index([organizationId, actingMembershipId, isActive])
  @@index([organizationId, actingRoleDefinitionId])
  @@index([organizationId, deletedAt])
  @@map("user_delegations")
}

// ==============================================================================
// 3. MULTI-SOURCE STRATEGIC PLANS, PILLARS, MANDATE-ANCHORED OBJECTIVES & KPIS
// ==============================================================================

enum PlanSourceType {
  NATIONAL_DEVELOPMENT_AGENDA // National Medium Term Plan / Presidential Manifesto
  FIVE_YEAR_STRATEGIC_PLAN    // Corporate 5-Year Institutional Blueprint
  CABINET_MINISTERIAL_DECREE  // High-priority ministerial decree / directive
  DONOR_GRANT_FRAMEWORK       // Bilateral / Multilateral donor grant agreement
  BOARD_ANNUAL_MANDATE        // Board of Directors governance mandate
  REGULATORY_COMPLIANCE       // Statutory oversight obligation
  SUSTAINABILITY_ESG          // ESG & Climate action framework
}

model PlanSource {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fiscalYearId   String?         @db.Uuid
  fiscalYear     FiscalYear?     @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)

  code           String          @db.VarChar(32)
  title          String          @db.VarChar(255)
  sourceType     PlanSourceType  @default(FIVE_YEAR_STRATEGIC_PLAN)
  issuingBody    String          @db.VarChar(255)
  documentRefNo  String?         @db.VarChar(100)
  documentUrl    String?         @db.Text
  validityStart  DateTime        @db.Date
  validityEnd    DateTime        @db.Date
