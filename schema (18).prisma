  appraisals     PerformanceAppraisal[]

  @@unique([organizationId, code, versionNo])
  @@index([organizationId, deletedAt])
  @@map("grading_scales")
}

model GradingBand {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  gradingScaleId String        @db.Uuid
  gradingScale   GradingScale  @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  gradeCode      String        @db.VarChar(32) // "EXCELLENT", "VERY_GOOD", "GOOD", "FAIR", "POOR"
  gradeName      String        @db.VarChar(128)
  minScore       Decimal       @db.Decimal(5, 2)
  maxScore       Decimal       @db.Decimal(5, 2)
  points         Decimal       @db.Decimal(5, 2)
  isPassing      Boolean       @default(true)
  colorHex       String?       @db.VarChar(16)
