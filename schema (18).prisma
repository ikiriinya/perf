}

// ==============================================================================
// 6. INDIVIDUAL PERFORMANCE AGREEMENTS (VERSIONED) & APPRAISALS
// ==============================================================================

enum AgreementStatus {
  DRAFT
  SUBMITTED_TO_SUPERVISOR
  IN_NEGOTIATION
  SIGNED_MUTUALLY         // Legally executed at start of year
  FROZEN_ACTIVE           // Active operating covenant during fiscal year
  AMENDED_BY_ADDENDUM     // Formally modified by signed addendum
}

enum AppraisalCycle {
  MID_YEAR_REVIEW         // Optional formal mid-year progress review
  ANNUAL_FINAL_EVALUATION // Mandatory formal end-of-year appraisal & scoring
  PERIODIC_MONITORING     // Quarterly milestone monitoring review
}

enum AppraisalStatus {
  APPRAISAL_DRAFT
  SELF_REVIEW_SUBMITTED
  SUPERVISOR_EVALUATED
  JOINT_REVIEW_CONCLUDED
  COUNTERSIGNED_CERTIFIED // Formally closed and audited
  DISPUTE_APPEAL
}

// DOCUMENT 1: INDIVIDUAL PERFORMANCE AGREEMENT MASTER
model PerformanceAgreement {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                 String                  @db.Uuid
  organization                   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  fiscalYearId                   String                  @db.Uuid
  fiscalYear                     FiscalYear              @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  // Performer (Employee Membership - Tenant Composite Key)
  membershipId                   String                  @db.Uuid
  membership                     OrganizationMembership  @relation("PerformerAgreement", fields: [membershipId], references: [id], onDelete: Restrict)

  orgUnitId                      String                  @db.Uuid
  orgUnit                        OrgUnit                 @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  supervisorMembershipId         String                  @db.Uuid
  supervisorMembership           OrganizationMembership  @relation("SupervisorAgreement", fields: [supervisorMembershipId], references: [id], onDelete: Restrict)

  countersigningMembershipId     String?                 @db.Uuid
  countersigningMembership       OrganizationMembership? @relation("CountersigningAgreement", fields: [countersigningMembershipId], references: [id], onDelete: SetNull)

  agreementCode                  String                  @db.VarChar(64) // e.g. "IPA-2025/2026-8810"
  title                          String                  @db.VarChar(255)
  status                         AgreementStatus         @default(DRAFT)
  currentVersionNo               Int                     @default(1)

  deletedAt                      DateTime?               @db.Timestamptz(6)
  createdAt                      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                @updatedAt @db.Timestamptz(6)

  // Versioned agreement lifecycle
  versions                       PerformanceAgreementVersion[]
  items                          PerformanceAgreementItem[]
  appraisals                     PerformanceAppraisal[]
  approvalRequests               ApprovalRequest[]

  @@unique([organizationId, fiscalYearId, membershipId])
  @@index([organizationId, membershipId, status])
  @@index([organizationId, supervisorMembershipId])
  @@index([organizationId, deletedAt])
  @@map("performance_agreements")
}

// Immutable version record of a Performance Agreement
model PerformanceAgreementVersion {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                  @db.Uuid
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  agreementId             String                  @db.Uuid
  agreement               PerformanceAgreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  versionNo               Int                     @default(1)
  status                  AgreementStatus         @default(DRAFT)
  totalWeight             Decimal                 @default(100.00) @db.Decimal(5, 2)

  signedAt                DateTime?               @db.Timestamptz(6)
  signatureHash           String?                 @db.VarChar(128)
  reason                  String?                 @db.Text
  isCurrent               Boolean                 @default(true)

  effectiveFrom           DateTime                @default(now()) @db.Date
  effectiveTo             DateTime?               @db.Date

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)

  items                   PerformanceAgreementItem[]
  addendumsAsAmended      PerformanceAgreementAddendum[] @relation("AmendedVersion")
  addendumsAsNew          PerformanceAgreementAddendum[] @relation("NewVersion")

  @@unique([agreementId, versionNo])
  @@index([organizationId, agreementId, isCurrent])
  @@index([organizationId, deletedAt])
  @@map("performance_agreement_versions")
}

// Formal addendum modifying an executed PerformanceAgreementVersion
model PerformanceAgreementAddendum {
  id                               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                   String                      @db.Uuid
  organization                     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  amendedVersionId                 String                      @db.Uuid
  amendedVersion                   PerformanceAgreementVersion @relation("AmendedVersion", fields: [amendedVersionId], references: [id], onDelete: Restrict)

  newVersionId                     String                      @db.Uuid
  newVersion                       PerformanceAgreementVersion @relation("NewVersion", fields: [newVersionId], references: [id], onDelete: Restrict)

  addendumNumber                   String                      @db.VarChar(64) // e.g. "ADDENDUM-01-FY26"
  justification                    String                      @db.Text
  approvedBySupervisorMembershipId String                      @db.Uuid
  approvedBySupervisorMembership   OrganizationMembership      @relation("AddendumApprover", fields: [approvedBySupervisorMembershipId], references: [id], onDelete: Restrict)
  approvedAt                       DateTime?                   @db.Timestamptz(6)
  effectiveDate                    DateTime                    @db.Date

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt                        DateTime                    @default(now()) @db.Timestamptz(6)

  @@unique([amendedVersionId, addendumNumber])
  @@index([organizationId, deletedAt])
  @@map("performance_agreement_addendums")
}

enum PerformanceAgreementItemType {
  WORKPLAN_CASCADE
  JOB_DESCRIPTION
  VALUES_COMPETENCY
}

// Commitment Item belongs strictly to a PerformanceAgreementVersion with NUMERIC target values & scoring rules
model PerformanceAgreementItem {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                      @db.Uuid
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  agreementId                String                      @db.Uuid
  agreement                  PerformanceAgreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  agreementVersionId         String                      @db.Uuid
  agreementVersion           PerformanceAgreementVersion @relation(fields: [agreementVersionId], references: [id], onDelete: Cascade)

  itemType                   PerformanceAgreementItemType @default(WORKPLAN_CASCADE)
  itemOrder                  Int                         @default(1)

  // Anchor References
  planSourceId               String?                     @db.Uuid
  planSource                 PlanSource?                 @relation(fields: [planSourceId], references: [id], onDelete: SetNull)

  strategicObjectiveId       String?                     @db.Uuid
  strategicObjective         StrategicObjective?         @relation(fields: [strategicObjectiveId], references: [id], onDelete: SetNull)

  kpiId                      String?                     @db.Uuid
  kpi                        KeyPerformanceIndicator?    @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  workplanActivityId         String?                     @db.Uuid
  workplanActivity           WorkplanActivity?           @relation(fields: [workplanActivityId], references: [id], onDelete: SetNull)

  workplanMonthlyScheduleId  String?                     @db.Uuid
  workplanMonthlySchedule    WorkplanMonthlySchedule?    @relation(fields: [workplanMonthlyScheduleId], references: [id], onDelete: SetNull)

  jobDescriptionDutyId       String?                     @db.Uuid
  jobDescriptionDuty         JobDescriptionDuty?         @relation(fields: [jobDescriptionDutyId], references: [id], onDelete: SetNull)

  competencyId               String?                     @db.Uuid
  competency                 Competency?                 @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  // Display Labels (Keep existing textual labels for presentation)
  targetDisplayLabel         String                      @db.Text
  deliverableOutput          String                      @db.Text
  performanceStandard        String                      @db.Text

  // NUMERIC TARGETS & SCORING DEFINITION (Phase 5 Plan-to-Appraisal Loop)
  targetValue                Decimal                     @default(0.0000) @db.Decimal(14, 4)
  baselineValue              Decimal?                    @db.Decimal(14, 4)
  thresholdValue             Decimal?                    @db.Decimal(14, 4)
  stretchValue               Decimal?                    @db.Decimal(14, 4)
  directionOfGood            KpiDirectionOfGood          @default(INCREASING_BETTER)

  scoringRuleId              String?                     @db.Uuid
  scoringRule                ScoringRule?                @relation(fields: [scoringRuleId], references: [id], onDelete: SetNull)

  weight                     Decimal                     @db.Decimal(5, 2) // Must sum to exactly 100.00
  meansOfVerification        String                      @db.Text
  agreedMilestoneDates       String?                     @db.Text

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)

  appraisalItems             PerformanceAppraisalItem[]

  @@unique([agreementVersionId, itemOrder])
  @@index([organizationId, agreementId])
  @@index([organizationId, itemType])
  @@index([strategicObjectiveId])
  @@index([planSourceId])
  @@index([workplanActivityId])
  @@index([jobDescriptionDutyId])
  @@index([competencyId])
  @@index([scoringRuleId])
  @@index([organizationId, deletedAt])
  @@map("performance_agreement_items")
}

// DOCUMENT 2: INDIVIDUAL PERFORMANCE APPRAISAL (Period-Keyed with Versioned Grading Scale)
model PerformanceAppraisal {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                 String                  @db.Uuid
  organization                   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  performanceAgreementId        String                  @db.Uuid
  performanceAgreement          PerformanceAgreement    @relation(fields: [performanceAgreementId], references: [id], onDelete: Restrict)

  membershipId                   String                  @db.Uuid
  membership                     OrganizationMembership  @relation("PerformerAppraisal", fields: [membershipId], references: [id], onDelete: Restrict)

  evaluatorSupervisorMembershipId String                 @db.Uuid
  evaluatorSupervisorMembership   OrganizationMembership  @relation("SupervisorAppraisal", fields: [evaluatorSupervisorMembershipId], references: [id], onDelete: Restrict)

  countersigningMembershipId     String?                 @db.Uuid
  countersigningMembership       OrganizationMembership? @relation("CountersigningAppraisal", fields: [countersigningMembershipId], references: [id], onDelete: SetNull)

  appraisalCode                  String                  @db.VarChar(64) // e.g. "APR-2025/2026-Q1-8810"
  cycle                          AppraisalCycle          @default(ANNUAL_FINAL_EVALUATION)
  periodKey                      String                  @default("ANNUAL") @db.VarChar(32) // "ANNUAL", "Q1", "Q2", "Q3", "Q4"
  status                         AppraisalStatus         @default(APPRAISAL_DRAFT)

  periodStartDate                DateTime                @db.Date
  periodEndDate                  DateTime                @db.Date

  // Scoring & Versioned Grading
  rawAverageScore                Decimal?                @db.Decimal(5, 2)
  compositeWeightedScore         Decimal?                @db.Decimal(5, 2)

  // Versioned Organization Grading Scale Linkage
  gradingScaleId                 String?                 @db.Uuid
  gradingScale                   GradingScale?           @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)
  gradingBandId                  String?                 @db.Uuid
  gradingBand                    GradingBand?            @relation(fields: [gradingBandId], references: [id], onDelete: SetNull)
  gradeCode                      String?                 @db.VarChar(32) // e.g. "GRADE_EXCELLENT", "GRADE_GOOD"

  supervisorRemarks              String?                 @db.Text
  employeeSelfAssessment         String?                 @db.Text
  remediationPlan                String?                 @db.Text
  commendationNote               String?                 @db.Text

  // Execution Signatures
  employeeEvaluatedAt            DateTime?               @db.Timestamptz(6)
  supervisorEvaluatedAt          DateTime?               @db.Timestamptz(6)
  countersignedAt                DateTime?               @db.Timestamptz(6)
  auditSignoffHash               String?                 @db.VarChar(128)

  deletedAt                      DateTime?               @db.Timestamptz(6)
  createdAt                      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                @updatedAt @db.Timestamptz(6)

  items                          PerformanceAppraisalItem[]
  competencyRatings              CompetencyRating[]
  calibrationAdjustments         CalibrationAdjustment[]
  appeals                        PerformanceAppraisalAppeal[]
  approvalRequests               ApprovalRequest[]

  @@unique([performanceAgreementId, cycle, periodKey])
  @@index([organizationId, membershipId, status])
  @@index([organizationId, deletedAt])
  @@index([gradingScaleId])
  @@index([gradingBandId])
  @@map("performance_appraisals")
}

// Appraisal Evaluation Line Item (Derivable Actuals & Source Tracking)
model PerformanceAppraisalItem {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                  @db.Uuid
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appraisalId             String                  @db.Uuid
  appraisal               PerformanceAppraisal    @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  // Direct reference to the specific Agreement commitment item
  agreementItemId         String                  @db.Uuid
  agreementItem           PerformanceAgreementItem @relation(fields: [agreementItemId], references: [id], onDelete: Restrict)

  // NUMERIC ACTUALS & SOURCE REFERENCE (Phase 5 Scoring Path)
  actualValue             Decimal?                @db.Decimal(14, 4)
  achievementPercent      Decimal?                @db.Decimal(7, 2) // e.g. 105.50%
  actualSourceType        String                  @default("MANUAL_ENTRY") @db.VarChar(64) // "MANUAL_ENTRY", "KPI_PERIODIC_TARGET", "WORKPLAN_MONTHLY_SCHEDULE"

  // Automated Derivation Source Pointers
  kpiPeriodicTargetId     String?                 @db.Uuid
  kpiPeriodicTarget       KpiPeriodicTarget?      @relation(fields: [kpiPeriodicTargetId], references: [id], onDelete: SetNull)

  workplanMonthlyScheduleId String?               @db.Uuid
  workplanMonthlySchedule WorkplanMonthlySchedule? @relation(fields: [workplanMonthlyScheduleId], references: [id], onDelete: SetNull)

  // Textual Reporting & Variances
  actualReportedOutput    String                  @db.Text
  varianceExplanation     String?                 @db.Text

  // Ratings
  selfRating              Decimal?                @db.Decimal(5, 2)
  supervisorRating        Decimal?                @db.Decimal(5, 2)
  agreedScore             Decimal?                @db.Decimal(5, 2)
  weightedScore           Decimal?                @db.Decimal(5, 2)

  // Evidence Verification
  verifiedEvidenceCount   Int                     @default(0)
  evaluatorRemarks        String?                 @db.Text

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)

  storyBankEntries        StoryBankEntry[]
  evidenceAttachments     EvidenceAttachment[]

  @@unique([appraisalId, agreementItemId])
  @@index([organizationId, appraisalId])
  @@index([organizationId, agreementItemId])
  @@index([kpiPeriodicTargetId])
  @@index([workplanMonthlyScheduleId])
  @@index([organizationId, deletedAt])
  @@map("performance_appraisal_items")
}

// ==============================================================================
// 7. CALIBRATION MODERATION SESSIONS, ADJUSTMENTS & APPEALS
// ==============================================================================

enum CalibrationStatus {
  SCHEDULED
  IN_PROGRESS
  CONCLUDED
  CANCELLED
}

model CalibrationSession {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                  @db.Uuid
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fiscalYearId            String                  @db.Uuid
  fiscalYear              FiscalYear              @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  orgUnitId               String?                 @db.Uuid
  orgUnit                 OrgUnit?                @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  sessionCode             String                  @db.VarChar(64)
  title                   String                  @db.VarChar(255)
  sessionDate             DateTime                @db.Date
  status                  CalibrationStatus       @default(SCHEDULED)

  committeeChairMembershipId String?              @db.Uuid
  committeeChairMembership OrganizationMembership? @relation("CalibrationChair", fields: [committeeChairMembershipId], references: [id], onDelete: SetNull)

  remarks                 String?                 @db.Text
  concludedAt             DateTime?               @db.Timestamptz(6)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)

  adjustments             CalibrationAdjustment[]

  @@unique([organizationId, sessionCode])
  @@index([organizationId, fiscalYearId])
  @@index([organizationId, deletedAt])
  @@map("calibration_sessions")
}

model CalibrationAdjustment {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                 @db.Uuid
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessionId            String                 @db.Uuid
  session              CalibrationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  appraisalId          String                 @db.Uuid
  appraisal            PerformanceAppraisal   @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  preCalibrationScore  Decimal                @db.Decimal(5, 2)
  postCalibrationScore Decimal                @db.Decimal(5, 2)

  // Direct closed-loop linkage to versioned GradingBand
  preCalibrationBandId String?                @db.Uuid
  preCalibrationBand   GradingBand?           @relation("PreCalibrationBand", fields: [preCalibrationBandId], references: [id], onDelete: SetNull)
  postCalibrationBandId String?               @db.Uuid
  postCalibrationBand  GradingBand?           @relation("PostCalibrationBand", fields: [postCalibrationBandId], references: [id], onDelete: SetNull)

  preCalibrationGrade  String                 @db.VarChar(32)
  postCalibrationGrade String                 @db.VarChar(32)
  justificationReason  String                 @db.Text

  approvedByMembershipId String               @db.Uuid
  approvedByMembership OrganizationMembership @relation("CalibrationApprover", fields: [approvedByMembershipId], references: [id], onDelete: Restrict)

  deletedAt            DateTime?              @db.Timestamptz(6)
  adjustedAt           DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([sessionId, appraisalId])
  @@index([organizationId, appraisalId])
  @@index([preCalibrationBandId])
  @@index([postCalibrationBandId])
  @@index([organizationId, deletedAt])
  @@map("calibration_adjustments")
}

enum AppealStatus {
  FILED
  COMMITTEE_REVIEW
  DETERMINED
  WITHDRAWN
}

enum AppealDecision {
  UPHELD_SCORE_INCREASED
  UPHELD_SCORE_DECREASED
  DISMISSED_CONFIRMED
  REFERRED_FOR_REEVALUATION
}

model PerformanceAppraisalAppeal {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                 @db.Uuid
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appraisalId          String                 @db.Uuid
  appraisal            PerformanceAppraisal   @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  appellantMembershipId String                @db.Uuid
  appellantMembership  OrganizationMembership @relation("AppraisalAppellant", fields: [appellantMembershipId], references: [id], onDelete: Restrict)

  appealCode           String                 @db.VarChar(64)
  groundsOfAppeal      String                 @db.Text
  disputedItemIds      Json?
  status               AppealStatus           @default(FILED)

  decision             AppealDecision?
  originalScore        Decimal                @db.Decimal(5, 2)
  adjustedScore        Decimal?               @db.Decimal(5, 2)

  // Direct linkage to revised GradingBand upon appeal resolution
  revisedGradingBandId String?                @db.Uuid
  revisedGradingBand   GradingBand?           @relation(fields: [revisedGradingBandId], references: [id], onDelete: SetNull)
  revisedGradeCode     String?                @db.VarChar(32)
  resolutionSummary    String?                @db.Text

  decidedByMembershipId String?               @db.Uuid
  decidedByMembership  OrganizationMembership? @relation("AppealDeterminer", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)
  decidedAt            DateTime?              @db.Timestamptz(6)

  deletedAt            DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, appealCode])
  @@index([organizationId, appraisalId])
  @@index([organizationId, appellantMembershipId])
  @@index([revisedGradingBandId])
  @@index([organizationId, deletedAt])
  @@map("performance_appraisal_appeals")
}

// ==============================================================================
// 8. CONFIGURABLE APPROVAL WORKFLOWS, REQUEST KINDS & MULTI-STAGE CHARTERS
// ==============================================================================

enum ApprovalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CANCELLED
}

enum ApprovalActionDecision {
  APPROVE
  REJECT
  REQUEST_REVISION
  DELEGATE
}

enum ApproverScope {
  SAME_UNIT
  PARENT_UNIT
  ORG_WIDE
  EXECUTIVE_OFFICE
}

enum ApproverDirection {
  UP_FROM_REQUESTER
  DOWN
}

enum ApproverFallbackAction {
  SKIP
  GO_UP
  USE_DELEGATE
  ESCALATE_TO_ROLE
}

enum ParallelExecutionType {
  ALL_MUST_APPROVE
  ANY_ONE_APPROVES
}

enum WorkflowEscalationAction {
  ESCALATE_TO_ROLE
  ESCALATE_TO_SUPERVISOR
  AUTO_APPROVE
  NOTIFY_ADMIN
}

// Request kinds are a tenant-managed table (workplan, agreement, appraisal, requisition, evidence sign-off, memo, KPI actuals, restructure)
model ApprovalRequestKind {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                   String                 @db.VarChar(64) // e.g. "WORKPLAN", "PERFORMANCE_AGREEMENT", "APPRAISAL", "REQUISITION", "EVIDENCE_SIGNOFF", "MEMO", "KPI_ACTUALS", "RESTRUCTURE"
  name                   String                 @db.VarChar(128) // e.g. "Operational Workplan", "Performance Contract"
  description            String?                @db.Text
  icon                   String?                @db.VarChar(64) // e.g. "FolderTree", "FileSignature", "FileCheck", "Users", "Layers"
  category               String?                @db.VarChar(64) // e.g. "OPERATIONS", "HUMAN_CAPITAL", "GOVERNANCE", "FINANCE"
  isSystemDefault        Boolean                @default(false)
  slaDefaultHours        Int                    @default(48)

  deletedAt              DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)

  workflows              ApprovalWorkflow[]
  requests               ApprovalRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("approval_request_kinds")
}

// Versioned workflow definition per organization and per request kind
model ApprovalWorkflow {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requestKindId          String                 @db.Uuid
  requestKind            ApprovalRequestKind    @relation(fields: [requestKindId], references: [id], onDelete: Restrict)

  code                   String                 @db.VarChar(64) // e.g. "WF-WORKPLAN-STANDARD", "WF-CAPEX-APPROVAL"
  name                   String                 @db.VarChar(128)
  version                Int                    @default(1)
  description            String?                @db.Text
  isDefault              Boolean                @default(true)
  isActive               Boolean                @default(true)

  deletedAt              DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)

  stages                 ApprovalStageConfig[]
  requests               ApprovalRequest[]

  @@unique([organizationId, requestKindId, version, code])
  @@index([organizationId, requestKindId, isActive])
  @@index([organizationId, deletedAt])
  @@map("approval_workflows")
}

// Multi-stage approval charter step with rules, conditions, parallel groups & fallbacks
model ApprovalStageConfig {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workflowId             String                 @db.Uuid
  workflow               ApprovalWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stageOrder             Int
  stageName              String                 @db.VarChar(128)
  description            String?                @db.Text

  // Approver Rule (Role, Target Unit Type, Direction, Levels, Scope)
  roleDefinitionId       String?                @db.Uuid
  roleDefinition         RoleDefinition?        @relation("StageApproverRole", fields: [roleDefinitionId], references: [id], onDelete: SetNull)

  targetUnitTypeId       String?                @db.Uuid
  targetUnitType         UnitType?              @relation(fields: [targetUnitTypeId], references: [id], onDelete: SetNull)

  direction              ApproverDirection      @default(UP_FROM_REQUESTER)
  levelsUp               Int                    @default(1)
  approverScope          ApproverScope          @default(ORG_WIDE)

  designatedMembershipId String?                @db.Uuid
  designatedMembership   OrganizationMembership? @relation("DesignatedStageApprover", fields: [designatedMembershipId], references: [id], onDelete: SetNull)

  // Vacancy / Inactive Fallback Rule
  fallbackAction         ApproverFallbackAction @default(GO_UP)
  fallbackRoleDefinitionId String?              @db.Uuid
  fallbackRoleDefinition RoleDefinition?        @relation("FallbackRoleStages", fields: [fallbackRoleDefinitionId], references: [id], onDelete: SetNull)

  // Allowed Actions
  canApprove             Boolean                @default(true)
  canReject              Boolean                @default(true)
  canRequestRevision     Boolean                @default(true)
  canDelegate            Boolean                @default(true)

  // Time Limit & Escalation
  slaHours               Int                    @default(48)
  escalationAction       WorkflowEscalationAction @default(ESCALATE_TO_ROLE)
  escalationRoleDefinitionId String?            @db.Uuid
  escalationRoleDefinition RoleDefinition?      @relation("EscalationRoleStages", fields: [escalationRoleDefinitionId], references: [id], onDelete: SetNull)

  // Parallel Stages
  isParallel             Boolean                @default(false)
  parallelGroupKey       String?                @db.VarChar(64)
  parallelExecutionType  ParallelExecutionType  @default(ALL_MUST_APPROVE)

  // Pre-compiled / Validated JSON Conditions
  conditionsJson         Json?

  deletedAt              DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)

  conditions             WorkflowStageCondition[]
  actions                ApprovalAction[]

  @@unique([workflowId, stageOrder])
  @@index([organizationId, workflowId])
  @@index([organizationId, roleDefinitionId])
  @@index([organizationId, targetUnitTypeId])
  @@index([organizationId, parallelGroupKey])
  @@index([organizationId, deletedAt])
  @@map("approval_stage_configs")
}

// Strongly-typed condition rows ensuring stages trigger only when predicate evaluates to true
enum StageConditionField {
  TOTAL_AMOUNT
  REQUESTER_UNIT_TYPE
  REQUESTER_ROLE
  REQUEST_KIND
  MIN_JOB_GRADE
  IS_CAPITAL_EXPENDITURE
  CUSTOM_ATTRIBUTE
}

enum StageConditionOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  IN_LIST
  NOT_IN_LIST
}

model WorkflowStageCondition {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stageConfigId          String                 @db.Uuid
  stageConfig            ApprovalStageConfig    @relation(fields: [stageConfigId], references: [id], onDelete: Cascade)

  field                  StageConditionField
  operator               StageConditionOperator
  valueString            String?                @db.VarChar(255)
  valueNumber            Decimal?               @db.Decimal(14, 2)
  valueBoolean           Boolean?
  valueJson              Json?
  logicalOperator        String                 @default("AND") @db.VarChar(8) // AND / OR

  deletedAt              DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)

  @@index([organizationId, stageConfigId])
  @@index([organizationId, deletedAt])
  @@map("workflow_stage_conditions")
}

// Immutable Request instance locked to the workflow version it started on
model ApprovalRequest {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workflowId             String                 @db.Uuid
  workflow               ApprovalWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion        Int                    @default(1)

  requestKindId          String?                @db.Uuid
  requestKind            ApprovalRequestKind?   @relation(fields: [requestKindId], references: [id], onDelete: SetNull)

  // Immutable frozen snapshot of workflow definition, stages, conditions, and approver rules at submission time
  workflowSnapshot       Json?

  currentStageOrder      Int                    @default(1)
  overallStatus          ApprovalStatus         @default(PENDING)

  requestedByMembershipId String                @db.Uuid
  requestedByMembership  OrganizationMembership @relation("ApprovalRequester", fields: [requestedByMembershipId], references: [id], onDelete: Restrict)

  // Request Evaluation Attributes (monetary amounts, severity, grade for condition matching)
  amount                 Decimal?               @db.Decimal(14, 2)
  payloadMetadata        Json?

  // Entity References: Exactly ONE must be populated (enforced via database CHECK)
  workplanId             String?                @db.Uuid
  workplan               Workplan?              @relation(fields: [workplanId], references: [id], onDelete: Cascade)

  performanceAgreementId String?                @db.Uuid
  performanceAgreement   PerformanceAgreement?  @relation(fields: [performanceAgreementId], references: [id], onDelete: Cascade)

  performanceAppraisalId String?                @db.Uuid
  performanceAppraisal   PerformanceAppraisal?  @relation(fields: [performanceAppraisalId], references: [id], onDelete: Cascade)

  kpiPeriodicTargetId    String?                @db.Uuid
  kpiPeriodicTarget      KpiPeriodicTarget?     @relation(fields: [kpiPeriodicTargetId], references: [id], onDelete: Cascade)

  restructureProposalId  String?                @db.Uuid
  restructureProposal    OrgRestructureProposal? @relation(fields: [restructureProposalId], references: [id], onDelete: Cascade)

  restructureOrgUnitId   String?                @db.Uuid
  restructureOrgUnit     OrgUnit?               @relation("OrgUnitRestructureApprovals", fields: [restructureOrgUnitId], references: [id], onDelete: Cascade)

  evidenceAttachmentId   String?                @db.Uuid
  evidenceAttachment     EvidenceAttachment?    @relation(fields: [evidenceAttachmentId], references: [id], onDelete: Cascade)

  deletedAt              DateTime?              @db.Timestamptz(6)
  submittedAt            DateTime               @default(now()) @db.Timestamptz(6)
  completedAt            DateTime?              @db.Timestamptz(6)

  actions                ApprovalAction[]
  auditTrails            AuditTrail[]

  @@index([organizationId, requestKindId, overallStatus])
  @@index([organizationId, requestedByMembershipId])
  @@index([workplanId])
  @@index([performanceAgreementId])
  @@index([performanceAppraisalId])
  @@index([kpiPeriodicTargetId])
  @@index([restructureProposalId])
  @@index([restructureOrgUnitId])
  @@index([evidenceAttachmentId])
  @@index([organizationId, deletedAt])
  @@map("approval_requests")
}

// Action log capturing decision, real actor, delegation replacement, and signature hash
model ApprovalAction {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @db.Uuid
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requestId              String                 @db.Uuid
  request                ApprovalRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stageConfigId          String?                @db.Uuid
  stageConfig            ApprovalStageConfig?   @relation(fields: [stageConfigId], references: [id], onDelete: SetNull)

  stageOrder             Int

  // Real Actor (who physically executed the decision)
  actorMembershipId      String                 @db.Uuid
  actorMembership        OrganizationMembership @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  // Substantive Approver on whose behalf the action was executed (if acting or delegated)
  actingOnBehalfOfMembershipId String?          @db.Uuid
  actingOnBehalfOfMembership OrganizationMembership? @relation("DelegatedApprovalSubstantive", fields: [actingOnBehalfOfMembershipId], references: [id], onDelete: SetNull)

  // Active delegation or acting position links
  delegationId           String?                @db.Uuid
  delegation             UserDelegation?        @relation(fields: [delegationId], references: [id], onDelete: SetNull)

  actingPositionAssignmentId String?            @db.Uuid
  actingPositionAssignment PositionAssignment?  @relation(fields: [actingPositionAssignmentId], references: [id], onDelete: SetNull)

  isDelegatedAction      Boolean                @default(false)
  delegationReason       String?                @db.Text

  decision               ApprovalActionDecision
  remarks                String?                @db.Text
  signatureHash          String?                @db.VarChar(128)
  ipAddress              String?                @db.VarChar(45)

  deletedAt              DateTime?              @db.Timestamptz(6)
  actedAt                DateTime               @default(now()) @db.Timestamptz(6)

  @@index([organizationId, requestId])
  @@index([organizationId, actorMembershipId])
  @@index([organizationId, actingOnBehalfOfMembershipId])
  @@index([delegationId])
  @@index([organizationId, deletedAt])
  @@map("approval_actions")
}

enum AuditActionType {
  RECORD_CREATED
  RECORD_UPDATED
  RECORD_DELETED
  STATUS_TRANSITION
  MUTUAL_SIGNATURE
  APPROVAL_GRANTED
  REVISION_ORDERED
  EVIDENCE_AUDITED
  SECURITY_OVERRIDE
}

model AuditTrail {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                 @db.Uuid
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  actorMembershipId  String?                @db.Uuid
  actorMembership    OrganizationMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  actorNameSnapshot  String?                @db.VarChar(200)
  actorEmailSnapshot String?                @db.VarChar(255)

  actionType         AuditActionType
  entityName         String                 @db.VarChar(64)
  entityId           String                 @db.Uuid
  summary            String                 @db.VarChar(500)

  previousState      Json?
  newState           Json?
  ipAddress          String?                @db.VarChar(45)
  userAgent          String?                @db.Text

  // Cryptographic immutability & hash chaining
  prevHash           String?                @db.VarChar(64)
  rowHash            String                 @db.VarChar(64)

  approvalRequestId  String?                @db.Uuid
  approvalRequest    ApprovalRequest?       @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  recordedAt         DateTime               @default(now()) @db.Timestamptz(6)
  deletedAt          DateTime?              @db.Timestamptz(6)

  @@index([organizationId, entityName, entityId])
  @@index([organizationId, recordedAt])
  @@index([organizationId, rowHash])
  @@index([actorMembershipId])
  @@index([organizationId, deletedAt])
  @@map("audit_trails")
}

enum StoryVerificationStatus {
  DRAFT_UNVERIFIED
  SUBMITTED_FOR_AUDIT
  VERIFIED_BY_SUPERVISOR
  AUDITED_BY_QA
  REJECTED_INSUFFICIENT_PROOF
}

// "Most specific link wins" rule applied: at most ONE parent governance link allowed
model StoryBankEntry {
  id                         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                  @db.Uuid
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  fiscalYearId               String                  @db.Uuid
  fiscalYear                 FiscalYear              @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  orgUnitId                  String                  @db.Uuid
  orgUnit                    OrgUnit                 @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  // Governance links: at most ONE is populated (enforced via database CHECK)
  strategicObjectiveId       String?                 @db.Uuid
  strategicObjective         StrategicObjective?     @relation(fields: [strategicObjectiveId], references: [id], onDelete: SetNull)

  kpiId                      String?                 @db.Uuid
  kpi                        KeyPerformanceIndicator? @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  workplanActivityId         String?                 @db.Uuid
  workplanActivity           WorkplanActivity?       @relation(fields: [workplanActivityId], references: [id], onDelete: SetNull)

  performanceAppraisalItemId String?                 @db.Uuid
  performanceAppraisalItem   PerformanceAppraisalItem? @relation(fields: [performanceAppraisalItemId], references: [id], onDelete: SetNull)

  headline                   String                  @db.VarChar(255)
  narrative                  String                  @db.Text
  beneficiaryStatement       String?                 @db.Text
  quantitativeImpact         Json?
  tags                       String[]

  verificationStatus         StoryVerificationStatus @default(DRAFT_UNVERIFIED)
  verifiedByAuditorMembershipId String?              @db.Uuid
  verifiedByAuditorMembership OrganizationMembership? @relation("StoryAuditor", fields: [verifiedByAuditorMembershipId], references: [id], onDelete: SetNull)
  verificationNotes          String?                 @db.Text
  verifiedAt                 DateTime?               @db.Timestamptz(6)
  certificateNumber          String?                 @unique @db.VarChar(64)

  isPubliclyShareable        Boolean                 @default(false)
  isFeatured                 Boolean                 @default(false)

  deletedAt                  DateTime?               @db.Timestamptz(6)
  createdAt                  DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(6)

  evidenceAttachments        EvidenceAttachment[]

  @@index([organizationId, verificationStatus])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, isFeatured])
  @@index([organizationId, deletedAt])
  @@index([strategicObjectiveId])
  @@index([kpiId])
  @@index([workplanActivityId])
  @@index([performanceAppraisalItemId])
  @@map("story_bank_entries")
}

enum EvidenceVerificationStatus {
  PENDING_SUPERVISOR_REVIEW
  SUPERVISOR_VERIFIED
  QA_AUDITED_CERTIFIED
  REVISION_REQUESTED
}

model EvidenceAttachment {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                     @db.Uuid
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Direct Attachment to Performance Appraisal Item
  performanceAppraisalItemId String?                    @db.Uuid
  performanceAppraisalItem   PerformanceAppraisalItem?  @relation(fields: [performanceAppraisalItemId], references: [id], onDelete: SetNull)

  // Linkages to Story Bank and Workplan Activity
  storyBankEntryId           String?                    @db.Uuid
  storyBankEntry             StoryBankEntry?            @relation(fields: [storyBankEntryId], references: [id], onDelete: SetNull)

  workplanActivityId         String?                    @db.Uuid
  workplanActivity           WorkplanActivity?          @relation(fields: [workplanActivityId], references: [id], onDelete: SetNull)

  title                      String                     @default("Evidence Document") @db.VarChar(255)

  // Tenant Lookup Table Category Reference (Replaced hardcoded enum)
  categoryId                 String                     @db.Uuid
  category                   EvidenceCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryCode               String?                    @db.VarChar(64)

  fileName                   String                     @db.VarChar(255)
  storageKey                 String                     @db.VarChar(512)
  fileUrl                    String?                    @db.Text
  mimeType                   String                     @db.VarChar(100)
  fileSizeBytes              BigInt
  checksumSha256             String                     @db.VarChar(64)

  verificationStatus         EvidenceVerificationStatus @default(PENDING_SUPERVISOR_REVIEW)
  verifiedByMembershipId     String?                    @db.Uuid
  verifiedByMembership       OrganizationMembership?    @relation("EvidenceVerifier", fields: [verifiedByMembershipId], references: [id], onDelete: SetNull)
  certificateNumber          String?                    @db.VarChar(64)
  verifiedAt                 DateTime?                  @db.Timestamptz(6)
  verificationNotes          String?                    @db.Text

  geotagLatitude             Decimal?                   @db.Decimal(10, 7)
  geotagLongitude            Decimal?                   @db.Decimal(10, 7)
  capturedAt                 DateTime?                  @db.Timestamptz(6)
  metadata                   Json?

  uploadedByMembershipId     String?                    @db.Uuid
  uploadedByMembership       OrganizationMembership?    @relation("AttachmentUploader", fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(6)

  approvalRequests           ApprovalRequest[]

  @@index([organizationId, performanceAppraisalItemId])
  @@index([organizationId, storyBankEntryId])
  @@index([organizationId, workplanActivityId])
  @@index([organizationId, categoryId])
  @@index([organizationId, verificationStatus])
  @@index([organizationId, deletedAt])
  @@map("evidence_attachments")
}

// ==============================================================================
// 9. REUSABLE TEMPLATES, ONBOARDING ENGINE & PLATFORM SUPPORT ACCESS
// ==============================================================================

enum TemplateSector {
  PUBLIC_SECTOR
  NGO
  PRIVATE
}

model TemplatePack {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String         @unique @db.VarChar(64)
  name             String         @db.VarChar(255)
  sector           TemplateSector @default(PUBLIC_SECTOR)
  version          String         @default("1.0.0") @db.VarChar(32)
  description      String?        @db.Text
  planYearsDefault Int            @default(5)
  packData         Json
  isActive         Boolean        @default(true)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  onboardings      OrganizationOnboarding[]

  @@index([deletedAt])
  @@map("template_packs")
}

model OrganizationOnboarding {
  id                          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
