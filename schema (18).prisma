  name                 String             @db.VarChar(128)
  definition           String             @db.Text
  behavioralIndicators String             @db.Text
  weight               Decimal            @default(10.00) @db.Decimal(5, 2)
  category             String             @default("CORE_VALUES") @db.VarChar(64)
  competencyType       String?            @default("BEHAVIORAL") @db.VarChar(32) // "FUNCTIONAL", "BEHAVIORAL", "LEADERSHIP"
  requiredLevel        String?            @default("ADVANCED") @db.VarChar(32)   // "BASIC", "INTERMEDIATE", "ADVANCED", "MASTERY"
  isActive             Boolean            @default(true)

  deletedAt            DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  jobDuties            JobDescriptionDuty[]
  ratings              CompetencyRating[]
  agreementItems       PerformanceAgreementItem[]

  @@unique([organizationId, code])
  @@index([organizationId, competencyType])
  @@index([organizationId, deletedAt])
  @@map("competencies")
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE_ADVERTISED
  INTERVIEWING
  OFFER_MADE
  FILLED
  CANCELLED
}

enum ApplicantStage {
  SOURCED
  SCREENING
  TECHNICAL_INTERVIEW
  BACKGROUND_VETTING
  OFFER_MADE
  DEPLOYED
  REJECTED
}

// Enterprise Staff Recruitment & Headcount Requisition
model RecruitmentRequisition {
  id                         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                  @db.Uuid
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orgUnitId                  String                  @db.Uuid
  orgUnit                    OrgUnit                 @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  requisitionCode            String                  @db.VarChar(64)
  jobTitle                   String                  @db.VarChar(150)
  jobRoleCode                String?                 @db.VarChar(64)
  salaryGrade                String                  @db.VarChar(64)
  headcountNeeded            Int                     @default(1)
  budgetAmount               Decimal?                @db.Decimal(14, 2)
  status                     RequisitionStatus       @default(DRAFT)

  // Primary linked baseline Job Description duty
  primaryDutyId              String?                 @db.Uuid
  primaryDuty                JobDescriptionDuty?     @relation(fields: [primaryDutyId], references: [id], onDelete: SetNull)

  // Hiring Manager (Supervisory or Dept Head Membership)
  hiringManagerMembershipId  String?                 @db.Uuid
  hiringManagerMembership    OrganizationMembership? @relation("RequisitionHiringManager", fields: [hiringManagerMembershipId], references: [id], onDelete: SetNull)

  openingDate                DateTime                @db.Date
  targetClosingDate          DateTime?               @db.Date
  requiredCompetencies       Json?

  deletedAt                  DateTime?               @db.Timestamptz(6)
  createdAt                  DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(6)

  applicants                 CandidateApplicant[]

  @@unique([organizationId, requisitionCode])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, status])
  @@index([organizationId, primaryDutyId])
  @@index([organizationId, hiringManagerMembershipId])
  @@index([organizationId, deletedAt])
  @@map("recruitment_requisitions")
}

// Candidate Applicants in Recruitment Pipeline
model CandidateApplicant {
  id                         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                  @db.Uuid
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requisitionId              String                  @db.Uuid
  requisition                RecruitmentRequisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  fullName                   String                  @db.VarChar(200)
  email                      String                  @db.VarChar(255)
  phoneNumber                String?                 @db.VarChar(32)
  experienceYears            Decimal?                @db.Decimal(4, 1)
  currentOrganization        String?                 @db.VarChar(255)
  matchScore                 Decimal?                @db.Decimal(5, 2)
  stage                      ApplicantStage          @default(SOURCED)
  appliedDate                DateTime                @default(now()) @db.Timestamptz(6)

  // On successful appointment / onboarding, link to substantive Membership
  deployedMembershipId       String?                 @db.Uuid
  deployedMembership         OrganizationMembership? @relation("ApplicantDeployedMembership", fields: [deployedMembershipId], references: [id], onDelete: SetNull)

