  periodKey      String                  @db.VarChar(32) // "ANNUAL", "Q1", "Q2", "Q3", "Q4"
  targetValue    Decimal                 @db.Decimal(14, 4)
  actualValue    Decimal?                @db.Decimal(14, 4)
  variance       Decimal?                @db.Decimal(14, 4)
  notes          String?                 @db.Text

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)

  @@unique([kpiId, orgUnitId, fiscalYearId, periodKey])
  @@index([organizationId, kpiId])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, fiscalYearId])
  @@index([organizationId, deletedAt])
  @@map("unit_kpi_targets")
}

// Presentation Section & Implementation Matrix Rows
enum MatrixRowLevel {
  OUTCOMES
  OUTPUTS
}

model StrategicPlanMatrixRow {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                  @db.Uuid
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planSourceId            String                  @db.Uuid
  planSource              PlanSource              @relation(fields: [planSourceId], references: [id], onDelete: Cascade)

  parentRowId             String?                 @db.Uuid
  parentRow               StrategicPlanMatrixRow? @relation("MatrixRowHierarchy", fields: [parentRowId], references: [id], onDelete: Restrict)
  childRows               StrategicPlanMatrixRow[] @relation("MatrixRowHierarchy")

  section                 MatrixRowLevel          @default(OUTCOMES)
  itemCode                String                  @db.VarChar(32) // e.g. "OUTCOME 1.1" or "OUTPUT 1.1.1"
  sortOrder               Int                     @default(1)

  objectiveId             String?                 @db.Uuid
  objective               StrategicObjective?     @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  kpiId                   String?                 @db.Uuid
  kpi                     KeyPerformanceIndicator? @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  timeframe               String?                 @db.VarChar(128)
  budgetAmount            Decimal                 @default(0.00) @db.Decimal(18, 2)
  currency                String                  @default("USD") @db.VarChar(8)
  budgetFormatted         String?                 @db.VarChar(64)

  keyInitiativeMajor      String?                 @db.Text
  keyInitiativeActivities String?                 @db.Text
  status                  String                  @default("ON_TRACK") @db.VarChar(32)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)

  @@unique([planSourceId, itemCode])
  @@index([organizationId, planSourceId])
  @@index([organizationId, section])
  @@index([parentRowId])
  @@index([kpiId])
  @@index([objectiveId])
  @@index([organizationId, deletedAt])
  @@map("strategic_plan_matrix_rows")
}

// ==============================================================================
// 4. MONTH-BY-MONTH DEPARTMENT/UNIT WORKPLANS (DELIVERING VS SUPPORTING)
// ==============================================================================

enum WorkplanStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  APPROVED
  REVISION_REQUESTED
  LOCKED
}

model Workplan {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @db.Uuid
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  fiscalYearId       String           @db.Uuid
  fiscalYear         FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  orgUnitId          String           @db.Uuid
  orgUnit            OrgUnit          @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  title              String           @db.VarChar(255)
  code               String           @db.VarChar(32)
  version            Int              @default(1)
  status             WorkplanStatus   @default(DRAFT)
  totalBudget        Decimal          @default(0.00) @db.Decimal(15, 2)

  remarks            String?          @db.Text
  approvedAt         DateTime?        @db.Timestamptz(6)
  deletedAt          DateTime?        @db.Timestamptz(6)

  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  activities         WorkplanActivity[]
  approvalRequests   ApprovalRequest[]

  @@unique([organizationId, fiscalYearId, orgUnitId, version])
  @@index([organizationId, orgUnitId, status])
  @@index([organizationId, deletedAt])
  @@map("workplans")
}

enum ActivityDeliveryType {
  DELIVERING_PRIMARY
  SUPPORTING_ENABLER
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  ON_TRACK
  DELAYED
  COMPLETED
  CANCELLED
}

// Workplan Activity linked to Workplan, Objective or KPI
model WorkplanActivity {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @db.Uuid
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workplanId            String               @db.Uuid
  workplan              Workplan             @relation(fields: [workplanId], references: [id], onDelete: Cascade)

  code                  String               @db.VarChar(32)
  activityName          String               @db.VarChar(300)
  description           String               @db.Text

  strategicObjectiveId  String?              @db.Uuid
  strategicObjective    StrategicObjective?  @relation(fields: [strategicObjectiveId], references: [id], onDelete: SetNull)

  kpiId                 String?              @db.Uuid
  kpi                   KeyPerformanceIndicator? @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  deliveryType          ActivityDeliveryType @default(DELIVERING_PRIMARY)
  explicitEvidenceRequirement String         @db.Text
  deliverable           String               @db.Text

  leadMembershipId      String?              @db.Uuid
  leadMembership        OrganizationMembership? @relation("ActivityLeadMembership", fields: [leadMembershipId], references: [id], onDelete: SetNull)

  budgetAllocated       Decimal              @default(0.00) @db.Decimal(15, 2)
  fundingSource         String?              @db.VarChar(128)
  riskDescription       String?              @db.Text
  mitigationStrategy    String?              @db.Text
  status                ActivityStatus       @default(PLANNED)

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(6)

  monthlySchedules      WorkplanMonthlySchedule[]
  performanceAgreementItems PerformanceAgreementItem[]
  storyBankEntries      StoryBankEntry[]
  evidenceAttachments   EvidenceAttachment[]

  @@unique([workplanId, code])
  @@index([organizationId, deliveryType])
  @@index([organizationId, strategicObjectiveId])
  @@index([organizationId, kpiId])
  @@index([organizationId, leadMembershipId])
  @@index([organizationId, deletedAt])
  @@map("workplan_activities")
}

enum MonthlyScheduleStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  PARTIALLY_ACHIEVED
  OFF_TRACK
  DEFERRED
}

model WorkplanMonthlySchedule {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String                 @db.Uuid
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  activityId               String                 @db.Uuid
  activity                 WorkplanActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)

  monthIndex               Int                    // 1 to 12
  monthName                String                 @db.VarChar(32) // e.g. "July", "August"

  targetMilestone          String                 @db.Text
  plannedMilestonePercent  Decimal                @default(0.00) @db.Decimal(5, 2)
  plannedExpenditure       Decimal                @default(0.00) @db.Decimal(15, 2)

  actualMilestoneDelivered String?                @db.Text
  actualProgressPercent    Decimal?               @db.Decimal(5, 2)
  actualExpenditure        Decimal?               @db.Decimal(15, 2)
  status                   MonthlyScheduleStatus  @default(NOT_STARTED)
  blockers                 String?                @db.Text

  deletedAt                  DateTime?                  @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)

  performanceAgreementItems PerformanceAgreementItem[]
  appraisalItems           PerformanceAppraisalItem[]

  @@unique([activityId, monthIndex])
  @@index([organizationId, activityId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("workplan_monthly_schedules")
}

// ==============================================================================
// 5. SCORING RULES, GRADING SCALES, JOB DUTIES & VALUE COMPETENCIES
// ==============================================================================

enum ScoringRuleType {
  LINEAR_INTERPOLATION
  STEP_BANDED
  BINARY_ALL_OR_NOTHING
  DECREASING_PENALTY
}

model ScoringRule {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code            String          @db.VarChar(32)
  name            String          @db.VarChar(128)
  ruleType        ScoringRuleType @default(LINEAR_INTERPOLATION)
  description     String?         @db.Text
  capAt100Percent Boolean         @default(false)
  minThreshold    Decimal?        @db.Decimal(5, 2)
  maxCap          Decimal?        @db.Decimal(5, 2)
